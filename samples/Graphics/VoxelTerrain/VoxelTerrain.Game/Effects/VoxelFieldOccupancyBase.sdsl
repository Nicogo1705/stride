namespace VoxelTerrain
{
    /// The occupancy pyramid's base level from the field: each entry is the least and greatest
    /// density of a 2x2x2-cell brick, over its 3x3x3 samples (bricks overlap by one sample, a cell's
    /// surface depending on its eight corners). Rounded outwards, so a brick never claims to be
    /// emptier than it is. See VoxelGridOccupancy in Stride.Voxels.
    shader VoxelFieldOccupancyBase : VoxelFieldBox
    {
        /// The field's finest level, and the pyramid's mip 0.
        stage Texture3D<float2> Field;
        stage RWTexture3D<float2> Target;
        stage int3 SampleCount;

        override void Compute()
        {
            int3 b = Texel();
            if (b.x < 0)
                return;
            int3 first = b * 2;

            float low = 1.0;
            float high = 0.0;
            [unroll]
            for (int z = 0; z <= 2; z++)
            {
                [unroll]
                for (int y = 0; y <= 2; y++)
                {
                    [unroll]
                    for (int x = 0; x <= 2; x++)
                    {
                        int3 s = first + int3(x, y, z);
                        float value = all(s < SampleCount) ? Field.Load(int4(s, 0)).r : 0.0;
                        low = min(low, value);
                        high = max(high, value);
                    }
                }
            }
            Target[b] = float2(floor(low * 255.0) / 255.0, ceil(high * 255.0) / 255.0);
        }
    };
}
