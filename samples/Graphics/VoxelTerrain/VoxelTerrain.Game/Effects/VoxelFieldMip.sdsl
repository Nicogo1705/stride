namespace VoxelTerrain
{
    /// One level of the field's mip chain from the level above it. Texel j stands over texel 2j of
    /// the finer level, filtered over its two neighbours along each axis (weights 2 and 1) so the
    /// surface smooths rather than aliases and keeps its place; the material is the centre texel's.
    /// The grid's level of detail reads these levels for the far field.
    shader VoxelFieldMip : VoxelFieldBox
    {
        /// Single-mip views: the finer level to read, this level to write.
        stage Texture3D<float2> Source;
        stage RWTexture3D<float2> Target;
        stage int3 SourceSize;

        override void Compute()
        {
            int3 c = Texel();
            if (c.x < 0)
                return;

            int3 centre = min(c * 2, SourceSize - 1);
            float sum = 0.0;
            float weight = 0.0;
            [unroll]
            for (int dz = -1; dz <= 1; dz++)
            {
                [unroll]
                for (int dy = -1; dy <= 1; dy++)
                {
                    [unroll]
                    for (int dx = -1; dx <= 1; dx++)
                    {
                        int3 s = centre + int3(dx, dy, dz);
                        if (any(s < 0) || any(s >= SourceSize))
                            continue;
                        float w = (dx == 0 ? 2.0 : 1.0) * (dy == 0 ? 2.0 : 1.0) * (dz == 0 ? 2.0 : 1.0);
                        sum += Source.Load(int4(s, 0)).r * w;
                        weight += w;
                    }
                }
            }
            Target[c] = float2(sum / weight, Source.Load(int4(centre, 0)).g);
        }
    };
}
