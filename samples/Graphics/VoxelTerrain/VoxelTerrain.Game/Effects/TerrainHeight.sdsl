namespace VoxelTerrain
{
    /// One column per (x, z) sample of a ring: the ground height, its slope, a tint noise for the
    /// material patches, and how cave-prone the column is. Computed once per ring here, in 2D, so
    /// the volume pass does not evaluate the height fractals for every one of its samples.
    shader TerrainHeight : ComputeShaderBase, TerrainNoise
    {
        stage RWTexture2D<float4> HeightsOut;
        /// The same columns at twice the minimum wavelength: what the next coarser ring sees, for the
        /// outer band of this ring to blend towards, so the two agree where they meet.
        stage RWTexture2D<float4> HeightsCoarseOut;
        stage int2 HeightSize;
        stage float2 WorldOriginXZ;
        stage float CellSize;

        float4 Column(float2 xz, float minWavelength)
        {
            float h = Height(xz, minWavelength);
            // The slope from the neighbouring columns, at the scale of the wavelength.
            float step = minWavelength * 0.5;
            float hx0 = Height(xz - float2(step, 0.0), minWavelength);
            float hx1 = Height(xz + float2(step, 0.0), minWavelength);
            float hz0 = Height(xz - float2(0.0, step), minWavelength);
            float hz1 = Height(xz + float2(0.0, step), minWavelength);
            float slope = length(float2(hx1 - hx0, hz1 - hz0)) / (2.0 * step);
            float tint = Fbm2(xz + Seed + 300.0, 1.0 / 35.0, 3, minWavelength);
            float caves = smoothstep(0.50, 0.65, Fbm2(xz + Seed + 4000.0, 1.0 / 300.0, 3, minWavelength));
            return float4(h, slope, tint, caves);
        }

        override void Compute()
        {
            int2 c = int2(streams.DispatchThreadId.xy);
            if (any(c >= HeightSize))
                return;

            float2 xz = WorldOriginXZ + c * CellSize;
            HeightsOut[c] = Column(xz, CellSize * 2.0);
            HeightsCoarseOut[c] = Column(xz, CellSize * 4.0);
        }
    };
}
