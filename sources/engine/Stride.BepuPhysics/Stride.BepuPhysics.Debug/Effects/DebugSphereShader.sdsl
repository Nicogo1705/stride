/// <summary>
/// Draws spheres as camera-facing circles of constant line width, or as dots once they are too small on screen to show a hole.
/// </summary>
/// <remarks> Each sphere is a segment from its center to a point of its surface. </remarks>
shader DebugSphereShader : DebugLineShaderBase, Math
{
    static const int Segments = 16;
    // A strip of two vertices per segment end, the last one closing the circle
    static const int VertexCount = 2 * (Segments + 1);
    // Spheres come by the hundred, overlapping: thinner outlines keep them readable
    static const float WidthScale = 0.5;
    static const float MinWidth = 1;

    stage override void VSMain()
    {
        streams.ShadingPosition = mul(streams.Position, ViewProjection);
    }

    [maxvertexcount(VertexCount)]
    void GSMain(line Input input[2], inout TriangleStream<Output> triangleStream)
    {
        float4 clip = input[0].ShadingPosition;
        if (clip.w < NearW)
            return;

        float radius = distance(input[0].Position.xyz, input[1].Position.xyz);
        // Depth tested at the point nearest to the camera, so a sphere resting on a surface is not half hidden by it
        float4 viewCenter = mul(float4(input[0].Position.xyz, 1), View);
        float4 front = mul(float4(viewCenter.xyz + float3(0, 0, radius), 1), Projection);
        if (front.w >= NearW)
            clip.z = front.z / front.w * clip.w;

        float width = max(LineWidth * WidthScale, MinWidth);
        float pixelRadius = radius * Projection[1][1] * ViewportSize.y * 0.5 / clip.w;
        float outer = pixelRadius + width * 0.5;
        // Filled once the hole would be narrower than the line, down to a dot as wide as the line
        float inner = pixelRadius >= width ? pixelRadius - width * 0.5 : 0;
        float2 toClip = 2 * clip.w / ViewportSize;

        streams = input[0];
        for (int i = 0; i <= Segments; i++)
        {
            float angle = i * (2 * Math.PI / Segments);
            float2 direction = float2(cos(angle), sin(angle)) * toClip;
            streams.ShadingPosition = clip + float4(direction * outer, 0, 0);
            triangleStream.Append(streams);
            streams.ShadingPosition = clip + float4(direction * inner, 0, 0);
            triangleStream.Append(streams);
        }
        triangleStream.RestartStrip();
    }
};
