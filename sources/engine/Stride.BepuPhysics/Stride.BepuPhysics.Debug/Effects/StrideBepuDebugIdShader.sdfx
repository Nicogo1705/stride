using Stride.Rendering;

namespace Stride.BepuPhysics.Debug
{
    partial effect StrideBepuDebugIdShader
    {
        using params StrideEffectBaseKeys;

        mixin BepuDebugIdShader;

        // A mesh whose vertex shader moves its vertices (a GPU deformation) brings it, as it does to the scene's effects
        var extension = StrideEffectBaseKeys.ExtensionPostVertexStageShader;
        if (extension != null)
        {
            mixin (extension);
        }
    }
}
