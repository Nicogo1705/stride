<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>$(StrideRuntimeTargetFrameworks)</TargetFrameworks>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StridePackAssets>true</StridePackAssets>
    <!-- Both, like every other engine package that ships shaders. StridePackAssets alone is not
         enough: the dev-package generator packs the whole solution with -p:StridePackAssets=false,
         which overrides this project's own value and drops the .sdsl from the stub - and the
         runtime effect compiler reads those off disk from the extracted package, so the engine
         then fails with "Unable to find shader [VoxelizeToFragments]". StrideContainsAssetTypes is
         not overridden, so the assets are packed either way. -->
    <StrideContainsAssetTypes>true</StrideContainsAssetTypes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\Stride.Native\Stride.Native.csproj" />
    <ProjectReference Include="..\Stride.Games\Stride.Games.csproj" />
    <ProjectReference Include="..\Stride.Rendering\Stride.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>