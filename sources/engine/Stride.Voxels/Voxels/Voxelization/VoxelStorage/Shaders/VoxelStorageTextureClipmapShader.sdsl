shader VoxelStorageTextureClipmapShader<float voxelSizeT, float clipCountT, float axisCountT, float mipHeightT> : VoxelStorageTextureShader, Texturing
{
    #define MapCount 20

    // How far into a ring the cross-fade to the next one starts, as a fraction of its half-extent.
    // Late enough that most samples never pay for the second fetch, early enough that the band is
    // wider than the step it is hiding.
    #define RingFadeStart 0.8
    cbuffer PerView.Lighting
    {
        float4 perMapOffsetScale[MapCount];
    }
    rgroup PerView.Lighting
    {
        Texture3D clipMaps;
        Texture3D mipMaps;
    }

    stage SamplerState LinearBorderSampler3D
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Border;
        AddressV = Border;
        AddressW = Border;
    };
    stage SamplerState LinearBorderSampler3D_NearestMip
    {
        Filter = MIN_MAG_LINEAR_MIP_POINT;
        AddressU = Border;
        AddressV = Border;
        AddressW = Border;
    };
    override float VoxelSize()
    {
        return voxelSizeT;
    }
    override float4 SampleRaw(float3 pos, float mipmap, int textureID, int axis)
    {
        if (textureID == 0)
        {
            return clipMaps.SampleLevel(Sampler, pos, 0);
        }
        else
        {
            return mipMaps.SampleLevel(Sampler, pos, mipmap);
        }
    }

    /// <summary>
    /// The finest map that actually holds <paramref name="pos"/>, searching from <paramref name="from"/>
    /// outwards. clipCountT when nothing does.
    /// </summary>
    /// <remarks>
    /// A ring only answers for its own box: outside it every fetch below is multiplied by zero. The
    /// map to read is picked from the cone's diameter alone, which is fine while the cone grows -
    /// but a tight cone never does. Its diameter stays at one voxel, so it asks for map 0 at every
    /// step and reads black from the moment it leaves the innermost box, however much geometry sits
    /// out there. That is a mirror: aperture is roughness times the cone ratio, so the more polished
    /// the surface, the smaller the box it can see, and a true mirror sees only the finest ring.
    /// Rings are nested and concentric, so the first one containing the position is the finest one
    /// that can answer at all - reading it costs sharpness, which is the correct thing to lose here,
    /// rather than the reflection itself.
    /// X and Z bound a ring; Y is clamped rather than bordered, exactly as OutsideVolume has it.
    /// </remarks>
    float MapContaining(float3 pos, int from)
    {
        for (int i = from; i < (int)clipCountT; i++)
        {
            float4 offsetScale = perMapOffsetScale[i];
            float3 volumePos = pos * offsetScale.w + offsetScale.xyz;

            // How far out in its own box this position sits: 0 at the centre, 1 on the boundary.
            float edge = max(abs(volumePos.x - 0.5), abs(volumePos.z - 0.5)) * 2.0;
            if (edge <= 1.0)
            {
                // Fractional, and that is the whole point. Sample already blends between the map it
                // lands on and the next one by the fraction of mipmap, so handing back i + a ramp
                // over the ring's outer band makes the crossing fade instead of snap - for free, in
                // the code that is already there. An integer here is what put a hard seam through
                // the middle of the room: rings are concentric boxes centred on the volume, so a
                // boundary crossing traces a rectangle across a floor, and a reflection walks
                // through several of them. Losing resolution gradually reads as depth; losing it in
                // one step reads as a bug, which is why a coarser volume with fewer rings can look
                // better than a fine one with many.
                return (float)i + saturate((edge - RingFadeStart) / (1.0 - RingFadeStart));
            }
        }

        // Outside every ring, stop at the coarsest one rather than falling through to the mipmap
        // chain. Those levels collapse the volume vertically - height shrinks by a factor of two
        // per level and the position is clamped to the middle slice - so what they hold is the room
        // flattened into a plate: the floor, the runner and the sky, with every wall averaged away.
        // A cone that lands there does not get a blurrier answer, it gets a diorama of the level
        // seen from above, and a sharp cone renders it recognisably. The largest ring covers the
        // whole volume anyway, so it is the right last resort.
        return clipCountT - 1;
    }

    // The mipmaps are downsampled from the largest clipmap, so that clipmap's extent bounds the
    // whole structure. X and Z address in Border mode, so past them every fetch returns zero - and
    // a straight ray never re-enters. Y is deliberately left out: it is clamped rather than
    // bordered (to keep a sample from bleeding into the neighbouring axis slice of the atlas), so
    // a position above or below the volume still reads the boundary plane.
    override bool OutsideVolume(float3 pos)
    {
        float4 offsetScale = perMapOffsetScale[(int)clipCountT - 1];
        float3 volumePos = pos * offsetScale.w + offsetScale.xyz;
        return volumePos.x < 0.0 || volumePos.x > 1.0
            || volumePos.z < 0.0 || volumePos.z > 1.0;
    }

    override float4 SampleNearestMip(float3 pos, float diameter, int axis)
    {
        diameter *= 1.0 / voxelSizeT;
        float mipmap = log2(max(1, diameter));
        return SampleByMipNearestMip(pos, mipmap, axis);
    }
    /// <summary>One map, no blending: the body this shader has always had, addressed explicitly.</summary>
    float4 FetchNearestMip(float3 pos, float mipmap, int axis)
    {
        //Clipmaps: the atlas holds one ring per column along X and one direction per row along Y,
        //so neither axis has to make room for the other and a ring costs 1/clipCount of the width.
        float3 clipMapSizeClip = float3(1.0 / clipCountT, 1.0 / axisCountT, 1);
        float3 axisStrideClip = float3(0, 1.0 / axisCountT, 0);
        float3 clipSetStrideClip = float3(1.0 / clipCountT, 0, 0);

        //Mipmaps
        float3 axisSizeMip = float3(1, 1.0 / (axisCountT), 1);
        float3 axisStrideMip = float3(0, 1.0 / (axisCountT), 0);

        float mipBase = floor(mipmap);

        float4 offsetScale = perMapOffsetScale[(int)mipBase];
        pos = pos * offsetScale.w + offsetScale.xyz;

        if (mipBase >= clipCountT)
        {
            //Seperate the different axis within the same texture
            //by clamping to the usable texel range
            //and fading out above and below
            float boundaryFade = 1.0;
            if (axisCountT > 1)
            {
                float height = mipHeightT / exp2(mipBase - clipCountT);

                float texelY = pos.y * height;
                float texelYClamped = clamp(texelY, 1, height - 1);
                boundaryFade = saturate(1.0 - abs(texelYClamped - texelY));

                pos.y = texelYClamped / height;

                pos *= axisSizeMip;
                pos += axisStrideMip * axis;
            }
            return mipMaps.SampleLevel(LinearBorderSampler3D_NearestMip, pos, mipBase - clipCountT) * boundaryFade;
        }
        else
        {
            // Outside this ring the answer is nothing, as it always was - but X now neighbours the
            // next ring instead of the border, so the zero has to be spelled out rather than left
            // to the sampler's addressing mode.
            float inside = (pos.x >= 0.0 && pos.x <= 1.0) ? 1.0 : 0.0;

            // Bilinear filtering reaches half a texel past the sample point, and past a ring's last
            // texel now sits the next ring's first. Hold the position that half texel inside its
            // own column so the filter cannot cross the seam.
            float halfTexelX = 0.25 / mipHeightT;
            pos.x = clamp(pos.x, halfTexelX, 1.0 - halfTexelX);
            pos.y = saturate(pos.y);

            pos *= clipMapSizeClip;
            pos += axisStrideClip * axis + clipSetStrideClip * mipBase;
            return clipMaps.SampleLevel(LinearBorderSampler3D_NearestMip, pos, 0) * inside;
        }
    }
    /// <summary>
    /// The diffuse cones come through here, and they used to land on one map with nothing either
    /// side of it: mipmap arrives as a whole step index, floor() keeps it whole, and the ring
    /// changes between one sample and the next. That edge is visible on a floor as a step in
    /// brightness rather than a gradient, because a coarser ring is a downsample - eight voxels
    /// where one held a lit wall average to an eighth of its radiance, and alpha compositing does
    /// not give all of that back. Each level is therefore slightly darker than the last, and
    /// without a blend the whole loss lands on one line across the room.
    /// <para>
    /// So fade over the outer fifth of whichever ring answers, into the one behind it. The second
    /// fetch is real cost on the hottest path in the shader, so it is taken only inside that band -
    /// away from a boundary this costs one comparison.
    /// </para>
    /// </summary>
    override float4 SampleByMipNearestMip(float3 pos, float mipmap, int axis)
    {
        // Never ask a ring for somewhere it does not cover - it would answer zero. See MapContaining.
        mipmap = max(mipmap, MapContaining(pos, (int)floor(mipmap)));

        float mipBase = floor(mipmap);
        float4 near = FetchNearestMip(pos, mipBase, axis);

        // Where in its own box this position sits: 0 at the centre, 1 on the boundary.
        float4 offsetScale = perMapOffsetScale[(int)mipBase];
        float3 volumePos = pos * offsetScale.w + offsetScale.xyz;
        float edge = max(abs(volumePos.x - 0.5), abs(volumePos.z - 0.5)) * 2.0;

        float blend = saturate((edge - RingFadeStart) / (1.0 - RingFadeStart));
        if (blend <= 0.0)
            return near;

        return lerp(near, FetchNearestMip(pos, mipBase + 1, axis), blend);
    }

    override float4 Sample(float3 pos, float diameter, int axis)
    {
        //Clipmaps: the atlas holds one ring per column along X and one direction per row along Y,
        //so neither axis has to make room for the other and a ring costs 1/clipCount of the width.
        float3 clipMapSizeClip = float3(1.0 / clipCountT, 1.0 / axisCountT, 1);
        float3 axisStrideClip = float3(0, 1.0 / axisCountT, 0);
        float3 clipSetStrideClip = float3(1.0 / clipCountT, 0, 0);

        //Mipmaps
        float3 axisSizeMip = float3(1, 1.0 / (axisCountT), 1);
        float3 axisStrideMip = float3(0, 1.0 / (axisCountT), 0);


        diameter *= 1.0 / voxelSizeT;
        float mipmap = log2(max(1, diameter));

        // Never ask a ring for somewhere it does not cover - it would answer zero. Raising mipmap
        // rather than mipBase keeps the fraction below in [0,1), so the blend across maps holds.
        mipmap = max(mipmap, MapContaining(pos, (int)floor(mipmap)));

        float mipBase = floor(mipmap);


        float4 offsetScale = perMapOffsetScale[(int)mipBase];
        float3 posFine = pos * offsetScale.w + offsetScale.xyz;

        offsetScale = perMapOffsetScale[(int)mipBase + 1];
        float3 posCoarse = pos * offsetScale.w + offsetScale.xyz;
        if (mipBase >= clipCountT)
        {
            //Seperate the different axis within the same texture
            //by clamping to the usable texel range
            //and fading out above and below
            float boundaryFade = 1.0;
            if (axisCountT > 1)
            {
                float height = mipHeightT / exp2(mipBase - clipCountT);

                float texelY = posFine.y * height;
                float texelYClamped = clamp(texelY, 1, height - 1);
                boundaryFade = saturate(1.0 - abs(texelYClamped - texelY));

                posFine.y = texelYClamped / height;

                posFine *= axisSizeMip;
                posFine += axisStrideMip * axis;

                posCoarse *= axisSizeMip;
                posCoarse += axisStrideMip * axis;
            }
            return lerp (
                mipMaps.SampleLevel(LinearBorderSampler3D, posFine, mipBase - clipCountT),
                mipMaps.SampleLevel(LinearBorderSampler3D, posCoarse, mipBase - clipCountT + 1),
                mipmap - mipBase) * boundaryFade;
        }
        else
        {
            float insideFine = (posFine.x >= 0.0 && posFine.x <= 1.0) ? 1.0 : 0.0;
            float insideCoarse = (posCoarse.x >= 0.0 && posCoarse.x <= 1.0) ? 1.0 : 0.0;

            // Half a texel of clearance, so the filter never reaches into the neighbouring ring.
            float halfTexelX = 0.25 / mipHeightT;
            posFine.x = clamp(posFine.x, halfTexelX, 1.0 - halfTexelX);
            posCoarse.x = clamp(posCoarse.x, halfTexelX, 1.0 - halfTexelX);
            posFine.y = saturate(posFine.y);
            posCoarse.y = saturate(posCoarse.y);
            if (mipBase == clipCountT-1)
            {
                posFine *= clipMapSizeClip;
                posFine += axisStrideClip * axis + clipSetStrideClip * mipBase;

                posCoarse *= axisSizeMip;
                posCoarse += axisStrideMip * axis;
                return lerp(
                    clipMaps.SampleLevel(LinearBorderSampler3D, posFine, 0) * insideFine,
                    mipMaps.SampleLevel(LinearBorderSampler3D, posCoarse, 0),
                    mipmap-mipBase
                );
            }
            else
            {
                posFine *= clipMapSizeClip;
                posFine += axisStrideClip * axis + clipSetStrideClip * mipBase;

                posCoarse *= clipMapSizeClip;
                posCoarse += axisStrideClip * axis + clipSetStrideClip * (mipBase+1);
                return lerp(
                    clipMaps.SampleLevel(LinearBorderSampler3D, posFine, 0) * insideFine,
                    clipMaps.SampleLevel(LinearBorderSampler3D, posCoarse, 0) * insideCoarse,
                    mipmap-mipBase
                );
            }
        }
    }
};
