namespace Stride.Rendering.Voxels
{
    shader ClearBuffer : ComputeShaderBase
    {
        stage RWBuffer<uint> buffer;
        int offset;

        // Direct3D11 caps a dispatch at 65535 groups per dimension, so groups are spread over X and Y
        // and the linear index is recomposed. rowLength is the elements covered by one row of groups;
        // count bounds the last row.
        int rowLength;
        int count;

        override void Compute()
        {
            uint index = streams.DispatchThreadId.x + streams.DispatchThreadId.y * (uint)rowLength;
            if (index < (uint)count)
                buffer[index + offset] = 0;
        }
    };
}
