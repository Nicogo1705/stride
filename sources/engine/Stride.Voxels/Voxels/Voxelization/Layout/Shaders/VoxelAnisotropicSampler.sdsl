namespace Stride.Rendering.Voxels
{
    shader VoxelAnisotropicSampler : IVoxelSampler, Texturing
    {
        compose VoxelStorageTextureShader storage;
        cbuffer PerView.Lighting
        {
            float maxBrightness;
        }
        
        // An axis weighted below this contributes under a percent of the sum; skipping it saves a set
        // of Texture3D fetches. Cones along a cardinal direction have two zero weights, so this is common.
        static const float AxisWeightCutoff = 0.01;

        float4 applyMaxBrightness(float4 col)
        {
            return float4(col.rgb * maxBrightness, col.a);
        }
        override float4 Sample(float3 position, float3 normal, float diameter)
        {
            float3 weights = abs(normal);
            float4 sum = float4(0, 0, 0, 0);

            if (weights.x > AxisWeightCutoff)
                sum += storage.Sample(position, diameter, normal.x > 0 ? 0 : 1) * weights.x;
            if (weights.y > AxisWeightCutoff)
                sum += storage.Sample(position, diameter, normal.y > 0 ? 2 : 3) * weights.y;
            if (weights.z > AxisWeightCutoff)
                sum += storage.Sample(position, diameter, normal.z > 0 ? 4 : 5) * weights.z;

            return applyMaxBrightness(sum);
        }
        override float4 SampleNearestMip(float3 position, float3 normal, float diameter)
        {
            float3 weights = abs(normal);
            float4 sum = float4(0, 0, 0, 0);

            if (weights.x > AxisWeightCutoff)
                sum += storage.SampleNearestMip(position, diameter, normal.x > 0 ? 0 : 1) * weights.x;
            if (weights.y > AxisWeightCutoff)
                sum += storage.SampleNearestMip(position, diameter, normal.y > 0 ? 2 : 3) * weights.y;
            if (weights.z > AxisWeightCutoff)
                sum += storage.SampleNearestMip(position, diameter, normal.z > 0 ? 4 : 5) * weights.z;

            return applyMaxBrightness(sum);
        }
        override float4 SampleByMipNearestMip(float3 position, float3 normal, float diameter)
        {
            float3 weights = abs(normal);
            float4 sum = float4(0, 0, 0, 0);

            if (weights.x > AxisWeightCutoff)
                sum += storage.SampleByMipNearestMip(position, diameter, normal.x > 0 ? 0 : 1) * weights.x;
            if (weights.y > AxisWeightCutoff)
                sum += storage.SampleByMipNearestMip(position, diameter, normal.y > 0 ? 2 : 3) * weights.y;
            if (weights.z > AxisWeightCutoff)
                sum += storage.SampleByMipNearestMip(position, diameter, normal.z > 0 ? 4 : 5) * weights.z;

            return applyMaxBrightness(sum);
        }
        override float4 SampleRaw(float3 pos, float mipmap, int textureID, int axis)
        {
            return storage.SampleRaw(pos, mipmap, textureID, axis);
        }
        override bool OutsideVolume(float3 position)
        {
            return storage.OutsideVolume(position);
        }
        override float VoxelSize()
        {
            return storage.VoxelSize();
        }
    };
}
