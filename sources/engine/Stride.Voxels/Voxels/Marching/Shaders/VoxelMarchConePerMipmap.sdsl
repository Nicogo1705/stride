shader VoxelMarchConePerMipmap<int steps> : VoxelMarchMethod, MarchAttributes
{
    #ifndef AttributeID
        #define AttributeID 0
    #endif
    cbuffer PerView.Lighting
    {
        float offset;
        float coneRatioInv;
    }
    override float4 March(float3 rayPos, float3 rayDir)
    {
        float voxelSize = AttributeSamplers[AttributeID].VoxelSize();
        rayPos += rayDir * voxelSize * offset;
        float dist = voxelSize * coneRatioInv;
        float size = 0;
        float4 light = float4(0.0, 0.0, 0.0, 0.0);
        [loop]
        for (int i = 0; i < steps; i++)
        {
            float3 pos = rayPos + rayDir * dist;

            // Left the volume: from here every sample returns nothing, and a straight ray never
            // comes back in. Without this a cone aimed at open space paid its full step count -
            // fetches, mip arithmetic and all - to accumulate zero.
            if (AttributeSamplers[AttributeID].OutsideVolume(pos))
                break;

            light += AttributeSamplers[AttributeID].SampleByMipNearestMip(pos, -rayDir, size) * saturate(1.0 - light.a);

            // The cone is saturated: everything behind this point is occluded, and each further
            // step would be scaled by (1 - light.a) ~ 0. In an interior most cones hit a wall
            // within a few steps, so this drops the bulk of the marching cost exactly where
            // cone tracing is at its most expensive.
            if (light.a >= 0.99)
                break;

            dist *= 2;
            size += 1;
        }
        return light;
    }

    override float StepSize() { return AttributeSamplers[AttributeID].VoxelSize(); }
};