shader VoxelMarchCone<int steps, float stepScale, float coneRatio, float offset> : VoxelMarchMethod, VoxelRadiusMarchMethod, MarchAttributes
{
    #ifndef sampleFunction
        #define sampleFunction Sample
        #define AttributeID 0
    #endif

    cbuffer PerView.Lighting
    {
        // How far the cone may travel, in world units. Zero keeps the old behaviour: no limit.
        //
        // A cone stops on saturation or on leaving the volume, and neither fires for a ray that
        // escapes a building. Walls stop occluding once the cone reads them from a coarse mip, so a
        // reflection ray passes through one a few metres out; and OutsideVolume only tests X and Z,
        // over a volume far larger than the rooms inside it. The ray then flies on through the
        // empty space around the geometry for the rest of its step budget and brings back the
        // outside of the building - which lands in the reflection as a small, legible copy of the
        // whole level, sitting wherever the view direction puts it. A tight cone makes it sharp
        // enough to recognise; a wide one only hides it in an average.
        //
        // Range is the honest fix, because the artefact is not what the ray found - it is that the
        // ray was still travelling at all.
        float maxTraceDistance;
    }

    override float4 March(float3 rayPos, float3 rayDir)
    {
        return MarchRadius(rayPos, rayDir, 1.0);
    }
    override float4 MarchRadius(float3 rayPos, float3 rayDir, float radiusScale)
    {
        float finalRatio = coneRatio.x * radiusScale;
        float voxelSize = AttributeSamplers[AttributeID].VoxelSize();
        
        float dist = voxelSize / max(1,finalRatio);

        float4 light = float4(0.0, 0.0, 0.0, 0.0);
        rayPos += offset * voxelSize * rayDir;

        // Stagger the start by a fraction of a step, hashed from where the ray begins.
        //
        // While the max above holds the diameter at one voxel the march advances by a fixed amount,
        // so its samples land on evenly spaced shells along the ray. Neighbouring pixels on a smooth
        // surface have smoothly varying ray lengths, so those shells come out as bands - and on a
        // sphere, whose reflected rays fan out around the view axis, as rings centred on it. The
        // spacing is the artefact, so breaking the spacing is the fix: offsetting each ray inside
        // its own first step turns a band into high-frequency noise, which reads as grain rather
        // than as structure and disappears under any blur.
        //
        // Hashed from the world position rather than from a frame counter, so it is stable: the
        // same point gets the same offset every frame and the grain does not crawl.
        float jitter = frac(sin(dot(rayPos, float3(12.9898, 78.233, 37.719))) * 43758.5453);
        dist += voxelSize * stepScale * jitter;

        for (int i = 0; i < steps; i ++)
        {
            if (maxTraceDistance > 0.0 && dist > maxTraceDistance)
                break;

            float diameter = max(voxelSize, finalRatio * dist);
            float3 pos = rayPos + rayDir * dist;

            // Left the volume: from here every sample returns nothing, and a straight ray never
            // comes back in. Without this a cone aimed at open space paid its full step count -
            // fetches, mip arithmetic and all - to accumulate zero.
            if (AttributeSamplers[AttributeID].OutsideVolume(pos))
                break;

            light += AttributeSamplers[AttributeID].sampleFunction(pos, -rayDir, diameter) * saturate(1.0 - light.a);

            // Saturated: every further sample is scaled by (1 - light.a) ~ 0. Specular cones run
            // up to 60 steps, and in an interior most of them hit a surface long before that.
            if (light.a >= 0.99)
                break;

            dist += diameter * stepScale;
        }
        return light;
    }
    override float StepSize() { return AttributeSamplers[AttributeID].VoxelSize(); }
    override float StepSizeRadius(float radiusScale) { return radiusScale * AttributeSamplers[AttributeID].VoxelSize(); }
};
