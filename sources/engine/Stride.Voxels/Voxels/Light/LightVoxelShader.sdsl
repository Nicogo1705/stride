using Stride.Rendering.Lights;
namespace Stride.Rendering.Voxels.VoxelGI
{
    /// <summary>
    /// Defines a Voxel environment light
    /// </summary>
    shader LightVoxelShader : MarchAttributes, Camera, Texturing, EnvironmentLight, MaterialPixelShadingStream, NormalStream, PositionStream4, Transformation, ShaderBaseStream
    {
        cbuffer PerView.Lighting
        {
            float Intensity;
            float SpecularIntensity;
            float SpecularRoughnessCutoff;
            float SpecularOffset;

            // Zero marches the diffuse cones here, per shaded pixel, as it always did. Otherwise
            // VoxelGIResolveShader traced them into a smaller buffer and this reads that instead;
            // the sizes are (1/screen width, 1/screen height, 1/buffer width, 1/buffer height).
            float GIResolveEnabled;
            float4 GIResolveSizes;

            // Non-zero while voxelizing: march bounceMarcher rather than diffuseMarcher. Uniform
            // over the whole draw - it is set per view - so the branch costs nothing and the side
            // not taken is never executed, which is the point when each side is a dozen cones.
            float BounceMarchEnabled;
        }

        rgroup PerView.Lighting
        {
            Texture2D GIResolveTexture;
        }

        compose VoxelMarchSet diffuseMarcher;
        compose VoxelMarchSet bounceMarcher;
        compose VoxelRadiusMarchMethod specularMarcher;

        /// <summary>
        /// Joint bilateral upsample of the reduced-resolution GI: the four texels around this
        /// pixel, each weighted by how much of the pixel it covers and by how close its surface is
        /// to this one.
        /// </summary>
        /// <remarks>
        /// The texels are read point-sampled, not filtered. Alpha carries the depth the colour was
        /// traced at, and a filtered fetch hands back a depth halfway between two surfaces -
        /// belonging to neither - so every comparison against it is wrong by an amount that follows
        /// the buffer's grid, which is exactly what a band across a wall is.
        /// </remarks>
        float3 SampleResolvedGI(float4 shadingPosition, out float valid)
        {
            float2 uv = shadingPosition.xy * GIResolveSizes.xy;
            float2 bufferSize = 1.0 / GIResolveSizes.zw;

            // Texel space, offset so the pixel's four neighbours are at (0,0)..(1,1).
            float2 coordinate = uv * bufferSize - 0.5;
            float2 origin = floor(coordinate);
            float2 subTexel = coordinate - origin;

            float depth = ZProjection.y / (shadingPosition.z - ZProjection.x);

            // How far a tap's surface may sit from this pixel's before the buffer is held to have
            // no answer here at all. The test exists for real breaks - a pane of glass shaded in
            // front of a wall it never wrote into, a silhouette - and must not fire on a merely
            // steep surface: a wall seen edge-on changes depth fast across the screen, the taps sit
            // a whole divisor of pixels away, and rejecting those bands the wall. So take the
            // surface's own slope over the distance travelled, and never less than a generous
            // fraction of the depth.
            float divisor = GIResolveSizes.z / GIResolveSizes.x;
            float slope = (abs(ddx(depth)) + abs(ddy(depth))) * divisor * 4.0;
            float tolerance = max(slope, depth * 0.15);

            float3 sum = float3(0, 0, 0);
            float total = 0;
            float nearest = 1e30;

            for (int i = 0; i < 4; i++)
            {
                float2 offset = float2(i & 1, (i >> 1) & 1);
                float4 tap = GIResolveTexture.SampleLevel(PointSampler, (origin + offset + 0.5) * GIResolveSizes.zw, 0);

                float tapDepth = ZProjection.y / (tap.a - ZProjection.x);
                float difference = abs(tapDepth - depth);
                nearest = min(nearest, difference);

                // Bilinear coverage, then how much this tap looks like the same surface.
                float2 coverage = lerp(1.0 - subTexel, subTexel, offset);
                float weight = coverage.x * coverage.y / (0.001 + difference);

                sum += tap.rgb * weight;
                total += weight;
            }

            // A ramp, not a verdict. This used to answer 0 or 1, and the caller either took the
            // upsample whole or threw it away and marched the cones again - two results that are
            // never quite equal, switched between from one pixel to the next. The line where the
            // switch happens follows every depth discontinuity in the frame, which in a room built
            // from alcoves and piers means every edge in sight, and a hard switch along an edge is
            // a staircase. Handing back how much the taps agree lets the caller cross fade instead,
            // so the seam becomes a gradient a couple of pixels wide.
            valid = saturate(1.0 - nearest / max(tolerance, 0.00001));
            return sum / max(total, 0.00001);
        }

        override void PrepareEnvironmentLight()
        {
            base.PrepareEnvironmentLight();
            if (Intensity > 0.0)
            {
                float3 worldPos = streams.PositionWS;

                // Uniform across the draw, so the branch costs nothing and the side not taken is
                // never executed - which is the entire point when the other side is twelve cones.
                float3 resolved = float3(0, 0, 0);
                float confidence = 0.0;
                if (GIResolveEnabled > 0.0)
                    resolved = SampleResolvedGI(streams.ShadingPosition, confidence);

                // Whatever the buffer cannot fully answer for - silhouettes, and every transparent
                // surface, which is shaded after the buffer was written and is not in it - marches
                // here, as it always did, and is then mixed in by however much the buffer was
                // trusted. Fully trusted pixels skip the march entirely, which is most of a wall;
                // the ones that pay for it are a narrow band along each edge, which is exactly
                // where the buffer had nothing useful to say.
                float3 diffuse = resolved;
                if (confidence < 1.0)
                {
                    // if/else rather than a ternary: both sides are a full cone set, and a ternary
                    // is free to evaluate both of them.
                    float3 marched;
                    if (BounceMarchEnabled > 0.0)
                        marched = bounceMarcher.March(worldPos, streams.normalWS.xyz).rgb;
                    else
                        marched = diffuseMarcher.March(worldPos, streams.normalWS.xyz).rgb;

                    diffuse = lerp(marched, resolved, confidence);
                }

                streams.envLightDiffuseColor = diffuse * Intensity;

                // The specular cone costs up to 60 steps per pixel, and on a rough surface its
                // result is a blur the diffuse cones already approximate. Fade it out as roughness
                // approaches the cutoff and skip the march entirely past it. The window above the
                // cutoff is 0.125 wide, so the default cutoff of 1 leaves every surface untouched.
                float roughness = sqrt(streams.alphaRoughness);
                float specularFade = SpecularIntensity * saturate((SpecularRoughnessCutoff - roughness) * 8.0 + 1.0);
                if (specularFade > 0.0)
                {
                    float3 startPos = worldPos + streams.normalWS.xyz * specularMarcher.StepSizeRadius(SpecularOffset);

                    // alphaRoughness, not roughness: the aperture of a GGX lobe follows alpha, and
                    // alpha is roughness squared - which is also the curve this needed. Linear in
                    // roughness, one global multiplier has to serve both ends of the material range
                    // and cannot: set it sharp enough for chrome and a 0.9-rough plaster wall gets a
                    // five-degree cone that hands back a legible image of the lamp; set it wide
                    // enough for the plaster and the mirrors go blind at arm's length. Squaring
                    // separates them - 0.9 stays 0.81 while 0.09 collapses to 0.008 - so one ratio
                    // finally fits the whole room. The cutoff above keeps plain roughness, which is
                    // what it is a threshold on.
                    streams.envLightSpecularColor = specularMarcher.MarchRadius(startPos, reflect(-streams.viewWS, streams.normalWS), streams.alphaRoughness).rgb * specularFade;
                }
                else
                {
                    streams.envLightSpecularColor = float4(0,0,0,0);
                }
            }
        }
    };
}
