using Stride.Rendering.Lights;
namespace Stride.Rendering.Voxels.VoxelGI
{
    /// <summary>
    /// Defines a Voxel environment light
    /// </summary>
    shader LightVoxelShader : MarchAttributes, Camera, Texturing, EnvironmentLight, MaterialPixelShadingStream, NormalStream, PositionStream4, Transformation, ShaderBaseStream
    {
        cbuffer PerView.Lighting
        {
            float Intensity;
            float SpecularIntensity;
            float SpecularRoughnessCutoff;
            float SpecularOffset;

            // What a cone that met nothing sees: credited by how much of it is still open.
            float3 SkyLight;

            // Zero marches the diffuse cones per shaded pixel; otherwise VoxelGIResolveShader traced them
            // into a smaller buffer and this reads it. Sizes: (1/screen w, 1/screen h, 1/buffer w, 1/buffer h).
            float GIResolveEnabled;
            float4 GIResolveSizes;

            // Non-zero while voxelizing: march bounceMarcher instead of diffuseMarcher. Set per view,
            // so the branch is uniform over the draw.
            float BounceMarchEnabled;
        }

        rgroup PerView.Lighting
        {
            Texture2D GIResolveTexture;
        }

        compose VoxelMarchSet diffuseMarcher;
        compose VoxelMarchSet bounceMarcher;
        compose VoxelRadiusMarchMethod specularMarcher;

        /// <summary>
        /// Joint bilateral upsample of the reduced-resolution GI from the four surrounding texels,
        /// weighted by coverage and by depth similarity.
        /// </summary>
        /// <remarks>
        /// Texels are point-sampled: alpha carries the traced depth, and a filtered depth belongs to neither surface.
        /// </remarks>
        float3 SampleResolvedGI(float4 shadingPosition, out float valid)
        {
            float2 uv = shadingPosition.xy * GIResolveSizes.xy;
            float2 bufferSize = 1.0 / GIResolveSizes.zw;

            // Texel space, offset so the pixel's four neighbours are at (0,0)..(1,1).
            float2 coordinate = uv * bufferSize - 0.5;
            float2 origin = floor(coordinate);
            float2 subTexel = coordinate - origin;

            float depth = ZProjection.y / (shadingPosition.z - ZProjection.x);

            // Depth tolerance: the surface's own slope over the tap distance, never less than 15% of depth,
            // so a wall seen edge-on is not rejected while real silhouettes are.
            float divisor = GIResolveSizes.z / GIResolveSizes.x;
            float slope = (abs(ddx(depth)) + abs(ddy(depth))) * divisor * 4.0;
            float tolerance = max(slope, depth * 0.15);

            float3 sum = float3(0, 0, 0);
            float total = 0;
            float nearest = 1e30;

            for (int i = 0; i < 4; i++)
            {
                float2 offset = float2(i & 1, (i >> 1) & 1);
                float4 tap = GIResolveTexture.SampleLevel(PointSampler, (origin + offset + 0.5) * GIResolveSizes.zw, 0);

                float tapDepth = ZProjection.y / (tap.a - ZProjection.x);
                float difference = abs(tapDepth - depth);
                nearest = min(nearest, difference);

                // Bilinear coverage, then how much this tap looks like the same surface.
                float2 coverage = lerp(1.0 - subTexel, subTexel, offset);
                float weight = coverage.x * coverage.y / (0.001 + difference);

                sum += tap.rgb * weight;
                total += weight;
            }

            // A confidence ramp rather than 0/1, so the caller can cross-fade to the inline march
            // instead of switching hard along every depth discontinuity.
            valid = saturate(1.0 - nearest / max(tolerance, 0.00001));
            return sum / max(total, 0.00001);
        }

        override void PrepareEnvironmentLight()
        {
            base.PrepareEnvironmentLight();
            if (Intensity > 0.0)
            {
                float3 worldPos = streams.PositionWS;

                // Uniform across the draw, so the side not taken is never executed.
                float3 resolved = float3(0, 0, 0);
                float confidence = 0.0;
                if (GIResolveEnabled > 0.0)
                    resolved = SampleResolvedGI(streams.ShadingPosition, confidence);

                // Pixels the buffer cannot fully answer for (silhouettes, transparent surfaces shaded
                // after it was written) march here and are blended in by the buffer's confidence.
                float3 diffuse = resolved;
                if (confidence < 1.0)
                {
                    // if/else rather than a ternary: both sides are a full cone set, and a ternary
                    // is free to evaluate both of them.
                    float4 cones;
                    if (BounceMarchEnabled > 0.0)
                        cones = bounceMarcher.March(worldPos, streams.normalWS.xyz);
                    else
                        cones = diffuseMarcher.March(worldPos, streams.normalWS.xyz);
                    float3 marched = cones.rgb + SkyLight * saturate(1.0 - cones.a);

                    diffuse = lerp(marched, resolved, confidence);
                }

                streams.envLightDiffuseColor = diffuse * Intensity;

                // On a rough surface the specular cone adds little over the diffuse cones: fade it out
                // below the cutoff and skip it past it. The fade window is 0.125 wide.
                float roughness = sqrt(streams.alphaRoughness);
                float specularFade = SpecularIntensity * saturate((SpecularRoughnessCutoff - roughness) * 8.0 + 1.0);
                if (specularFade > 0.0)
                {
                    float3 startPos = worldPos + streams.normalWS.xyz * specularMarcher.StepSizeRadius(SpecularOffset);

                    // alphaRoughness (roughness squared) drives the cone aperture, as it does a GGX lobe,
                    // so one cone ratio fits both polished and rough materials. The cutoff above uses plain roughness.
                    float4 mirror = specularMarcher.MarchRadius(startPos, reflect(-streams.viewWS, streams.normalWS), streams.alphaRoughness);
                    streams.envLightSpecularColor = (mirror.rgb + SkyLight * saturate(1.0 - mirror.a)) * specularFade;
                }
                else
                {
                    streams.envLightSpecularColor = float4(0,0,0,0);
                }
            }
        }
    };
}
