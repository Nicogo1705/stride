namespace Stride.Rendering.Voxels.Grid
{
    /// A grid held in a structured buffer, one value per sample, density in bits 0-7 and material in
    /// bits 8-15, laid out x-major with z varying fastest.
    ///
    /// This is the packing a voxel game commonly keeps its chunks in, where uploading is a widen
    /// from 16 to 32 bits and nothing else. The material byte is the palette index as it stands.
    shader VoxelGridSourcePackedBuffer : IVoxelGridSource
    {
        // Linked to fixed keys, whatever this shader is mixed into. An unlinked member takes the path
        // it was reached by into its parameter name - through a material, layers[N].materialPixelStage
        // with an N nothing outside the generator knows - and a value set under any other name binds
        // nothing. Linking is how the engine's own material textures reach a shader at any depth.
        rgroup PerMaterial
        {
            [Link("VoxelGridField.Data")]
            stage StructuredBuffer<uint> VoxelGridData;
        }

        cbuffer PerMaterial
        {
            [Link("VoxelGridField.SampleCount")]
            stage int3 VoxelGridSampleCount;
        }

        override int3 SampleCount()
        {
            return VoxelGridSampleCount;
        }

        uint Fetch(int3 coord)
        {
            int index = (coord.x * VoxelGridSampleCount.y + coord.y) * VoxelGridSampleCount.z + coord.z;
            return VoxelGridData[index];
        }

        override float Density(int3 coord)
        {
            return (Fetch(coord) & 0xFF) / 255.0;
        }

        override int MaterialId(int3 coord)
        {
            return (int)((Fetch(coord) >> 8) & 0xFF);
        }
    };
}
