namespace Stride.Rendering.Voxels.Grid
{
    effect VoxelGridResolveEffect
    {
        using params VoxelGridResolveShaderKeys;

        mixin VoxelGridResolveShader;
        // The traversal arrives already carrying its own source composition, built on the C# side -
        // so swapping DDA for a hardware traced or distance field implementation changes this file
        // not at all.
        if (VoxelGridResolveShaderKeys.Traversal != null)
        {
            mixin compose Traversal = VoxelGridResolveShaderKeys.Traversal;
        }
    }
}
