namespace Stride.Rendering.Voxels.Grid
{
    /// A grid held in a 3D texture: density in red, material id in green, as an R8G8 texture.
    ///
    /// The form a generator writing straight from a compute shader tends to produce, and the one
    /// that costs least to sample. A single channel texture works too - every sample then points
    /// at palette entry 0.
    shader VoxelGridSourceTexture3D : IVoxelGridSource
    {
        // Linked to fixed keys, whatever this shader is mixed into. An unlinked member takes the path
        // it was reached by into its parameter name - through a material, layers[N].materialPixelStage
        // with an N nothing outside the generator knows - and a value set under any other name binds
        // nothing. Linking is how the engine's own material textures reach a shader at any depth.
        rgroup PerMaterial
        {
            [Link("VoxelGridField.Texture")]
            stage Texture3D<float2> VoxelGridTexture;
        }

        cbuffer PerMaterial
        {
            [Link("VoxelGridField.SampleCount")]
            stage int3 VoxelGridSampleCount;

            /// Mip levels beyond the first. Each halves the samples per axis, as a texture mip
            /// does; a level's sample j stands over the finest level's sample j * 2^level, so the
            /// surfaces of two levels sit on one another.
            [Link("VoxelGridField.LodLevels")]
            stage int VoxelGridLodLevels;
        }

        override int LodLevels()
        {
            return max(VoxelGridLodLevels, 0);
        }

        override int3 SampleCount()
        {
            return max(VoxelGridSampleCount >> VoxelGridLod, int3(2, 2, 2));
        }

        override float Density(int3 coord)
        {
            return VoxelGridTexture.Load(int4(coord, VoxelGridLod)).r;
        }

        override int MaterialId(int3 coord)
        {
            // A byte stored as a normalized channel comes back as id / 255.
            return (int)round(VoxelGridTexture.Load(int4(coord, VoxelGridLod)).g * 255.0);
        }
    };
}
