namespace Stride.Rendering.Voxels.Grid
{
    /// A grid held in a 3D texture: density in red, albedo in green, blue and alpha.
    ///
    /// The form a generator writing straight from a compute shader tends to produce, and the one
    /// that costs least to sample. A single channel texture works too - the albedo simply comes
    /// back black, which a renderer can ignore in favour of a flat colour.
    shader VoxelGridSourceTexture3D : IVoxelGridSource
    {
        // Linked to fixed keys, whatever this shader is mixed into. An unlinked member takes the path
        // it was reached by into its parameter name - through a material, layers[N].materialPixelStage
        // with an N nothing outside the generator knows - and a value set under any other name binds
        // nothing. Linking is how the engine's own material textures reach a shader at any depth.
        rgroup PerMaterial
        {
            [Link("VoxelGridField.Texture")]
            stage Texture3D<float4> VoxelGridTexture;
        }

        cbuffer PerMaterial
        {
            [Link("VoxelGridField.SampleCount")]
            stage int3 VoxelGridSampleCount;
        }

        override int3 SampleCount()
        {
            return VoxelGridSampleCount;
        }

        override float Density(int3 coord)
        {
            return VoxelGridTexture.Load(int4(coord, 0)).r;
        }

        override float3 Albedo(int3 coord)
        {
            return VoxelGridTexture.Load(int4(coord, 0)).gba;
        }
    };
}
