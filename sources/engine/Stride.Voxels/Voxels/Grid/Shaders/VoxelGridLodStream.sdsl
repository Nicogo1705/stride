namespace Stride.Rendering.Voxels.Grid
{
    /// The level of detail a field is read at, as a stream shared by every reader in a stage. Level N reads a field
    /// 2^N times coarser. Every entry point writes it before any read: a vertex stage that draws a field writes zero,
    /// whoever starts a walk sets it through IVoxelGridTraversal.SetLod.
    shader VoxelGridLodStream
    {
        stage stream int VoxelGridLod;
    };
}
