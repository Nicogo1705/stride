namespace Stride.Rendering.Voxels.Grid
{
    effect VoxelGridBeamEffect
    {
        using params VoxelGridBeamShaderKeys;

        mixin VoxelGridBeamShader;
        // The traversal arrives with its source composed on the C# side, as for the resolve.
        if (VoxelGridBeamShaderKeys.Traversal != null)
        {
            mixin compose Traversal = VoxelGridBeamShaderKeys.Traversal;
        }
    }
}
