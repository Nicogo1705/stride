namespace Stride.Rendering.Voxels.Grid
{
    /// Finds the surface of a grid once per pixel and writes what a material needs to draw it: position, normal and material id.
    /// A field is drawn by one draw per material; walking once here and letting each draw read the answer keeps the
    /// material count from multiplying the cost of the walk. Depth is written too, so several grids resolve against one another.
    /// Drawn as the grid's proxy box, so only the pixels under its footprint march; the ray comes from the pixel, not the box.
    shader VoxelGridResolveShader : ShaderBase, PositionStream4, VoxelGridRay, VoxelGridDither, VoxelGridLodStream
    {
        compose IVoxelGridTraversal Traversal;

        float4x4 VoxelGridViewProjection;
        float4x4 VoxelGridWorld;
        float4x4 VoxelGridWorldViewProjection;

        /// The scene's depth where it is drawn already, and 1 when it is bound: a ray stops at the
        /// opaque surface in front of the grid. Depth 1.0 is nothing drawn and bounds nothing.
        Texture2D VoxelGridSceneDepth;
        float VoxelGridSceneDepthBound;

        /// What VoxelGridBeamShader wrote, one texel per block of VoxelGridBeamBlock pixels a side; 0 pixels leaves it unread.
        stage Texture2D<float> VoxelGridBeam;
        int VoxelGridBeamBlock;

        /// How far along the ray the surface is looked for, in grid local units.
        float VoxelGridMaxDistance;

        /// See VoxelGridDither.
        int VoxelGridDither;

        /// Which grid this is, so a material of one grid does not claim a pixel of another.
        int VoxelGridIndex;

        /// The ids drawn see-through, a bit per id: ids 0-127 in the first, 128-255 in the second.
        int4 VoxelGridTransparent0;
        int4 VoxelGridTransparent1;

        // See-through surfaces kept in front of the opaque one; a further one is drawn as opaque
        static const int MaxTransparentLayers = 2;
        // Cells per step when walking through see-through matter, and the most steps one span may take
        static const float TransparentStepCells = 0.25;
        static const int MaxTransparentSteps = 256;

        bool IsTransparent(int id)
        {
            int word = clamp(id, 0, 255) >> 5;
            int4 words = word < 4 ? VoxelGridTransparent0 : VoxelGridTransparent1;
            uint bits = asuint(words[word & 3]);
            return ((bits >> (uint)(id & 31)) & 1u) != 0;
        }

        /// The material just inside a surface: a hit on a cell face lands in either cell by rounding.
        int MaterialInside(float3 localPosition, float3 localNormal, int2 pixel)
        {
            return Traversal.SurfaceMaterialId(localPosition - localNormal * (0.05 * Traversal.CellSizeAtLod()), pixel, VoxelGridDither);
        }

        /// A layer as the materials read it: world normal and the id and grid packed in w (0 is no layer); world position and depth.
        void PackLayer(float3 localPosition, float3 localNormal, int material, out float4 normalId, out float4 positionDepth)
        {
            float3 worldPosition = mul(float4(localPosition, 1), VoxelGridWorld).xyz;
            float4 clip = mul(float4(worldPosition, 1), VoxelGridViewProjection);
            normalId = float4(normalize(mul((float3x3)VoxelGridWorldInverse, localNormal)), 1 + material + 256 * VoxelGridIndex);
            positionDepth = float4(worldPosition, clip.z / clip.w);
        }

        /// Level of detail: how many grid units a pixel covers per unit of distance along the ray,
        /// and a bias in levels (positive is coarser). Zero units turns it off.
        float VoxelGridLodPixel;
        float VoxelGridLodBias;

        stage override void VSMain()
        {
            streams.ShadingPosition = mul(streams.Position, VoxelGridWorldViewProjection);
        }

        stage override void PSMain()
        {
            streams.ColorTarget = Shading();
        }

        stage float4 Shading()
        {
            // Written first, before any read of the field: the level the walks are made at.
            streams.VoxelGridLod = 0;
            // The ray through the pixel, from the near plane to the far one: right under any
            // projection, so an orthographic camera in the editor resolves as a perspective one.
            int2 pixel = (int2)streams.ShadingPosition.xy;
            float3 localOrigin;
            float3 localDirection;
            float directionScale;
            ViewRay(streams.ShadingPosition.xy, localOrigin, localDirection, directionScale);

            float hitDistance;
            float3 localNormal;
            bool found;
            // The walk starts where the ray enters the box, not at the near plane: the reach is the field's own extent,
            // and the walk's float distance keeps the box's precision however far the camera is.
            float enter = Traversal.EnterDistance(localOrigin, localDirection);
            float reach = VoxelGridMaxDistance;
            // The scene's surface on this ray, in the grid's units from the entry: a ray behind it
            // has a reach below zero and the walk ends before its first cell.
            float sceneDepth = VoxelGridSceneDepth.Load(int3(pixel, 0)).x;
            float2 uv = streams.ShadingPosition.xy / VoxelGridViewSize;
            float2 ndc = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
            float4 sceneClip = mul(float4(ndc, sceneDepth, 1.0), VoxelGridViewProjectionInverse);
            float3 sceneLocal = mul(float4(sceneClip.xyz / sceneClip.w, 1), VoxelGridWorldInverse).xyz;
            float sceneReach = dot(sceneLocal - localOrigin, localDirection) - enter;
            float bounded = VoxelGridSceneDepthBound * (1.0 - step(1.0, sceneDepth));
            reach = lerp(reach, min(reach, sceneReach), bounded);
            // Or further, where the beam of the pixel's block found nothing up to; negative says nothing along the block.
            float start = enter;
            if (VoxelGridBeamBlock > 0)
            {
                float beam = VoxelGridBeam.Load(int3(pixel / VoxelGridBeamBlock, 0));
                if (beam < 0)
                {
                    discard;
                }
                start = max(enter, beam);
            }
            localOrigin += localDirection * start;
            reach -= start - enter;
            int levels = Traversal.LodLevelCount();
            // Only when some pixel of the field can want a coarser level at all: the farthest
            // reach of the walk, at this pixel size, still under level one means every pixel walks
            // the finest level and the coarse pass would be a cost with no return.
            float farthest = Traversal.LodAt((start + reach) * directionScale, VoxelGridLodPixel) + VoxelGridLodBias;
            if (levels > 0 && VoxelGridLodPixel > 0 && farthest >= 1.0)
            {
                // Coarse first: the coarsest level finds roughly where the surface is, the hit distance picks the level this
                // pixel wants, and that level is walked from a little before the coarse hit. The level is fractional and dithered.
                // The coarse pass stops four levels short of the last: sixteen samples a side still place a surface.
                int coarse = max(levels - 4, 0);
                Traversal.SetLod(coarse);
                found = Traversal.Trace(localOrigin, localDirection, reach, hitDistance, localNormal);
                if (!found)
                {
                    // What the coarse level lost - a thin thing, a silhouette - is looked for at
                    // the finest, from the start: a miss must not become a hole.
                    Traversal.SetLod(0);
                    found = Traversal.Trace(localOrigin, localDirection, reach, hitDistance, localNormal);
                }
                else
                {
                    float wanted = Traversal.LodAt((start + hitDistance) * directionScale, VoxelGridLodPixel) + VoxelGridLodBias;
                    int lod = clamp((int)floor(wanted + DitherThreshold(pixel, VoxelGridDither)), 0, levels);
                    if (lod < coarse)
                    {
                        float coarseCell = Traversal.CellSizeAtLod();
                        Traversal.SetLod(lod);
                        float back = max(hitDistance - 2.0 * coarseCell, 0.0);
                        float3 nearOrigin = localOrigin + localDirection * back;
                        float nearDistance;
                        float3 nearNormal;
                        if (Traversal.Trace(nearOrigin, localDirection, reach - back, nearDistance, nearNormal))
                        {
                            hitDistance = back + nearDistance;
                            localNormal = nearNormal;
                        }
                        else
                        {
                            // The finer surface is not where the coarse one was: keep the coarse
                            // answer rather than punch a hole, and read the material at its level.
                            Traversal.SetLod(coarse);
                        }
                    }
                }
            }
            else
            {
                Traversal.SetLod(0);
                // The reach is in the grid's own units, as the direction was made unit length in them.
                found = Traversal.Trace(localOrigin, localDirection, reach, hitDistance, localNormal);
            }
            if (!found)
            {
                discard;
            }

            int material = MaterialInside(localOrigin + localDirection * hitDistance, localNormal, pixel);

            // A see-through surface is kept as a layer and the ray goes on: through the matter, to where it leaves into air
            // or meets another material, and on to the next surface, until an opaque one or the layers run out.
            float4 layerNormal0 = 0, layerPosition0 = 0, layerNormal1 = 0, layerPosition1 = 0;
            int layerCount = 0;
            bool opaque = true;
            bool walking = IsTransparent(material);
            float step = TransparentStepCells * Traversal.CellSizeAtLod();
            for (int surface = 0; surface <= MaxTransparentLayers; surface++)
            {
                if (walking)
                {
                    if (layerCount == MaxTransparentLayers)
                    {
                        walking = false;
                    }
                    else
                    {
                        float4 normalId, positionDepth;
                        PackLayer(localOrigin + localDirection * hitDistance, localNormal, material, normalId, positionDepth);
                        layerNormal0 = layerCount == 0 ? normalId : layerNormal0;
                        layerPosition0 = layerCount == 0 ? positionDepth : layerPosition0;
                        layerNormal1 = layerCount == 1 ? normalId : layerNormal1;
                        layerPosition1 = layerCount == 1 ? positionDepth : layerPosition1;
                        layerCount++;

                        float t = hitDistance + step * 0.5;
                        bool inside = true;
                        int next = material;
                        for (int i = 0; i < MaxTransparentSteps && inside && next == material; i++)
                        {
                            float3 p = localOrigin + localDirection * t;
                            inside = t < reach && Traversal.IsSolid(p);
                            next = inside ? Traversal.SurfaceMaterialId(p, pixel, 0) : material;
                            t += inside && next == material ? step : 0;
                        }

                        if (inside && next != material)
                        {
                            // Another material inside the matter: its face looks back along the ray
                            hitDistance = t;
                            localNormal = -localDirection;
                            material = next;
                            walking = IsTransparent(material);
                        }
                        else if (t < reach)
                        {
                            // Out into air: on to the next surface
                            float nextDistance;
                            float3 nextNormal;
                            float3 from = localOrigin + localDirection * t;
                            bool more = Traversal.Trace(from, localDirection, reach - t, nextDistance, nextNormal);
                            hitDistance = t + nextDistance;
                            localNormal = nextNormal;
                            material = more ? MaterialInside(localOrigin + localDirection * hitDistance, localNormal, pixel) : material;
                            walking = more && IsTransparent(material);
                            opaque = more;
                        }
                        else
                        {
                            walking = false;
                            opaque = false;
                        }
                    }
                }
            }

            float3 localPosition = localOrigin + localDirection * hitDistance;
            float3 worldPosition = mul(float4(localPosition, 1), VoxelGridWorld).xyz;
            float3 worldNormal = normalize(mul((float3x3)VoxelGridWorldInverse, localNormal));

            float4 hitClip = mul(float4(worldPosition, 1), VoxelGridViewProjection);
            float depth = hitClip.z / hitClip.w;
            // Seen only through glass, the grid still owns the pixel at the nearest layer
            streams.Depth = opaque ? depth : layerPosition0.w;

            // The opaque surface: the normal with a 1 in w that says "resolved"; the material id and the grid index, a byte each;
            // the world position with the depth in w. Then two see-through layers, nearest first.
            streams.ColorTarget1 = opaque ? float4(material / 255.0, VoxelGridIndex / 255.0, 0, 1) : float4(0, 0, 0, 0);
            streams.ColorTarget2 = opaque ? float4(worldPosition, depth) : float4(0, 0, 0, 0);
            streams.ColorTarget3 = layerNormal0;
            streams.ColorTarget4 = layerPosition0;
            streams.ColorTarget5 = layerNormal1;
            streams.ColorTarget6 = layerPosition1;
            return opaque ? float4(worldNormal, 1) : float4(0, 0, 0, 0);
        }
    };
}
