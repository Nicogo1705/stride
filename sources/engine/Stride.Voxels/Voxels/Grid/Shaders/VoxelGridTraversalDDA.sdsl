namespace Stride.Rendering.Voxels.Grid
{
    /// Walks the cells a ray crosses, in order, and stops where the surface actually is.
    ///
    /// Two steps, and the split is the whole design. A three dimensional DDA skips cells: clip the
    /// ray to the grid box, then step along whichever axis reaches its next boundary first. That
    /// needs nothing but the field - no acceleration structure to build, no distance field to
    /// precompute, nothing to rebuild when a voxel changes - and it visits exactly the cells the ray
    /// meets, because a regular grid already is the structure a ray wants.
    ///
    /// Then, inside the one cell that contains the surface, the crossing is solved on the trilinear
    /// field. Stopping at the cell instead would draw the grid rather than the surface, which reads
    /// as a staircase however fine the cells are - and it would disagree with the mesh a renderer or
    /// a collider builds from the same samples, which interpolate exactly this way.
    ///
    /// A sphere tracer would take larger steps through empty space, but it needs a distance correct
    /// everywhere; a marching cubes density field only guarantees the sign, and sphere tracing across
    /// one walks through walls. When empty space becomes the cost, the answer is a coarse occupancy
    /// pyramid to skip whole bricks, not a change of algorithm.
    shader VoxelGridTraversalDDA : IVoxelGridTraversal, IVoxelGridSource
    {
        // The source is inherited, not composed: whichever packing is chosen is mixed in alongside
        // this shader and overrides SampleCount, Density and Albedo.
        //
        // Composition is the wrong tool here, and the reason is what it does to resources. Each
        // composition is its own scope with its own copy of every declaration, which is right for a
        // tree of compute-colour nodes that each want their own parameters, and wrong for a field
        // that one texture holds and several places read: the material declares the texture in its
        // scope, the composed source reads a different variable of the same name in another, and the
        // texture binds to nothing at all. Stride mixes rather than composes wherever parts share
        // state - the shading model, the diffuse model, normal mapping are all mixins - and this
        // shares state.

        /// Edge length of one cell, in grid local space.
        cbuffer PerMaterial
        {
            [Link("VoxelGridField.CellSize")]
            stage float VoxelGridCellSize;

        /// Density at or above which a sample counts as solid.
            [Link("VoxelGridField.IsoLevel")]
            stage float VoxelGridIsoLevel;

        /// 1 reads the samples on the outer faces of the grid as air, closing the volume with real
        /// surface. 0 leaves them alone, for a grid that continues into a neighbour.
            [Link("VoxelGridField.SealBorder")]
            stage float VoxelGridSealBorder;

        /// Which surface the walk stops on. 0: the cells themselves, a world of cubes. 1: the
        /// crossing on the trilinear field, which is where marching cubes puts its vertices. 2: the
        /// plane through the cell's surface-nets vertex, which is what surface nets meshes.
        ///
        /// All three walk the same cells; only what counts as a hit differs. Offering all three is
        /// what lets a collider be asked for the same surface, so the body that is drawn and the
        /// body that is solid are one body rather than two that follow each other.
            [Link("VoxelGridField.SurfaceMode")]
            stage float VoxelGridSurfaceMode;

        /// Ceiling on the cells one ray may visit. A ray crossing a 256 cell grid corner to corner
        /// touches on the order of 768, so this bounds the worst case rather than the common one.
            [Link("VoxelGridField.MaxSteps")]
            stage int VoxelGridMaxSteps;
        }

        /// Bisection steps that place the crossing once the interval holding it is known. Each
        /// halves the error, so six put the surface within a sixty-fourth of a cell - well below
        /// what a pixel resolves.
        static const int RefineSteps = 6;

        /// Density of one sample, with the border read as air when the grid is sealed.
        ///
        /// A surface exists only where the field crosses the iso level, and a grid whose edge is
        /// solid never crosses there - so its sides and its underside are not surface at all. They
        /// still appear, because a ray entering the volume already inside matter stops on the box
        /// itself, but that is a flat face with the box's normal and a decision taken per ray, which
        /// is why the join against the real surface comes out in steps a cell wide.
        float SealedDensity(int3 coord)
        {
            int3 samples = SampleCount();
            if (VoxelGridSealBorder > 0.5 && (any(coord <= 0) || any(coord >= samples - int3(1, 1, 1))))
                return 0.0;

            return Density(coord);
        }

        /// The field between samples, trilinear - the same reconstruction marching cubes and surface
        /// nets interpolate along their edges, so the traced surface and a meshed one agree.
        float SampleField(float3 localPosition)
        {
            float3 grid = localPosition / VoxelGridCellSize;
            int3 cell = (int3)floor(grid);
            float3 f = grid - (float3)cell;

            float d000 = SealedDensity(cell + int3(0, 0, 0));
            float d100 = SealedDensity(cell + int3(1, 0, 0));
            float d010 = SealedDensity(cell + int3(0, 1, 0));
            float d110 = SealedDensity(cell + int3(1, 1, 0));
            float d001 = SealedDensity(cell + int3(0, 0, 1));
            float d101 = SealedDensity(cell + int3(1, 0, 1));
            float d011 = SealedDensity(cell + int3(0, 1, 1));
            float d111 = SealedDensity(cell + int3(1, 1, 1));

            float dx00 = lerp(d000, d100, f.x);
            float dx10 = lerp(d010, d110, f.x);
            float dx01 = lerp(d001, d101, f.x);
            float dx11 = lerp(d011, d111, f.x);
            return lerp(lerp(dx00, dx10, f.y), lerp(dx01, dx11, f.y), f.z);
        }

        /// The albedo between samples, on the same trilinear weights as the field.
        ///
        /// Reading it from the cell the hit landed in instead makes the colour change on cell
        /// boundaries, which draws a staircase along every material boundary - on a surface that is
        /// otherwise perfectly smooth, so it reads as a geometry fault rather than what it is.
        float3 SampleAlbedo(float3 localPosition)
        {
            float3 grid = localPosition / VoxelGridCellSize;
            int3 cell = (int3)floor(grid);
            float3 f = grid - (float3)cell;

            float3 a000 = Albedo(cell + int3(0, 0, 0));
            float3 a100 = Albedo(cell + int3(1, 0, 0));
            float3 a010 = Albedo(cell + int3(0, 1, 0));
            float3 a110 = Albedo(cell + int3(1, 1, 0));
            float3 a001 = Albedo(cell + int3(0, 0, 1));
            float3 a101 = Albedo(cell + int3(1, 0, 1));
            float3 a011 = Albedo(cell + int3(0, 1, 1));
            float3 a111 = Albedo(cell + int3(1, 1, 1));

            float3 ax00 = lerp(a000, a100, f.x);
            float3 ax10 = lerp(a010, a110, f.x);
            float3 ax01 = lerp(a001, a101, f.x);
            float3 ax11 = lerp(a011, a111, f.x);
            return lerp(lerp(ax00, ax10, f.y), lerp(ax01, ax11, f.y), f.z);
        }

        /// Central differences on the reconstructed field, half a cell apart. Taken at the hit rather
        /// than at cell corners, so the normal turns continuously across a face instead of snapping
        /// to it.
        float3 FieldGradient(float3 localPosition)
        {
            float h = VoxelGridCellSize * 0.5;
            return float3(
                SampleField(localPosition + float3(h, 0, 0)) - SampleField(localPosition - float3(h, 0, 0)),
                SampleField(localPosition + float3(0, h, 0)) - SampleField(localPosition - float3(0, h, 0)),
                SampleField(localPosition + float3(0, 0, h)) - SampleField(localPosition - float3(0, 0, h)));
        }

        /// Whether a cell counts as solid when the surface is not being interpolated: the mean of
        /// its eight corners reaches the iso level. The same rule the voxel collider's box form
        /// applies, so cubes drawn and cubes collided against are the same cubes.
        bool CellIsSolid(int3 cell)
        {
            float sum =
                SealedDensity(cell + int3(0, 0, 0)) + SealedDensity(cell + int3(1, 0, 0)) +
                SealedDensity(cell + int3(1, 0, 1)) + SealedDensity(cell + int3(0, 0, 1)) +
                SealedDensity(cell + int3(0, 1, 0)) + SealedDensity(cell + int3(1, 1, 0)) +
                SealedDensity(cell + int3(1, 1, 1)) + SealedDensity(cell + int3(0, 1, 1));
            return sum * 0.125 >= VoxelGridIsoLevel;
        }

        /// Whether the surface can pass through a cell: its eight corners are not all on the same
        /// side of the iso level. Eight loads, and it rejects almost every cell a ray meets.
        bool CellStraddles(int3 cell)
        {
            float iso = VoxelGridIsoLevel;
            int inside = 0;
            inside += SealedDensity(cell + int3(0, 0, 0)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(1, 0, 0)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(0, 1, 0)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(1, 1, 0)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(0, 0, 1)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(1, 0, 1)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(0, 1, 1)) >= iso ? 1 : 0;
            inside += SealedDensity(cell + int3(1, 1, 1)) >= iso ? 1 : 0;
            return inside > 0 && inside < 8;
        }

        override float3 Probe(float3 localPosition)
        {
            int3 cell = clamp((int3)floor(localPosition / VoxelGridCellSize), int3(0, 0, 0), SampleCount() - int3(2, 2, 2));
            return float3(SampleCount().x / 128.0, SealedDensity(cell), VoxelGridIsoLevel);
        }

        /// One edge's contribution to the mean of the crossings: the crossing in xyz, and 1 in w
        /// when the surface passes through that edge at all.
        ///
        /// A value in and a value out, with no inout parameter and no early return. Those are what
        /// the shader compiler would not finish on - not an error, a compile that never returns, so
        /// the game hangs waiting for a task rather than reporting anything.
        float4 EdgeCrossing(int3 a, int3 b)
        {
            float iso = VoxelGridIsoLevel;
            float da = SealedDensity(a);
            float db = SealedDensity(b);

            float delta = db - da;
            float t = abs(delta) > 1e-6 ? saturate((iso - da) / delta) : 0.5;
            // Not named 'point': that is a reserved word in the shader language, and the parse
            // failure it causes is reported against the line after it.
            float3 crossing = lerp((float3)a, (float3)b, t) * VoxelGridCellSize;

            bool crosses = (da >= iso) != (db >= iso);
            return crosses ? float4(crossing, 1) : float4(0, 0, 0, 0);
        }

        /// The one vertex surface nets keeps for a cell: the mean of the crossings on its edges,
        /// in xyz, with the number of them in w.
        float4 CellVertex(int3 c)
        {
            float4 sum = float4(0, 0, 0, 0);

            sum += EdgeCrossing(c + int3(0, 0, 0), c + int3(1, 0, 0));
            sum += EdgeCrossing(c + int3(0, 1, 0), c + int3(1, 1, 0));
            sum += EdgeCrossing(c + int3(0, 0, 1), c + int3(1, 0, 1));
            sum += EdgeCrossing(c + int3(0, 1, 1), c + int3(1, 1, 1));

            sum += EdgeCrossing(c + int3(0, 0, 0), c + int3(0, 1, 0));
            sum += EdgeCrossing(c + int3(1, 0, 0), c + int3(1, 1, 0));
            sum += EdgeCrossing(c + int3(0, 0, 1), c + int3(0, 1, 1));
            sum += EdgeCrossing(c + int3(1, 0, 1), c + int3(1, 1, 1));

            sum += EdgeCrossing(c + int3(0, 0, 0), c + int3(0, 0, 1));
            sum += EdgeCrossing(c + int3(1, 0, 0), c + int3(1, 0, 1));
            sum += EdgeCrossing(c + int3(0, 1, 0), c + int3(0, 1, 1));
            sum += EdgeCrossing(c + int3(1, 1, 0), c + int3(1, 1, 1));

            return sum.w > 0 ? float4(sum.xyz / sum.w, 1) : float4(0, 0, 0, 0);
        }

        /// Which way the field rises across a cell, from its eight corners.
        ///
        /// Eight reads, against the forty-eight a central difference on the reconstructed field
        /// costs. That matters more than it looks: every read goes through the source composition,
        /// and the shader compiler inlines those - a normal taken the expensive way, for several
        /// cells, inside a walk of hundreds of steps, is a compile that never finishes rather than
        /// one that reports anything.
        float3 CellNormal(int3 c)
        {
            float d000 = SealedDensity(c + int3(0, 0, 0));
            float d100 = SealedDensity(c + int3(1, 0, 0));
            float d010 = SealedDensity(c + int3(0, 1, 0));
            float d001 = SealedDensity(c + int3(0, 0, 1));
            float d110 = SealedDensity(c + int3(1, 1, 0));
            float d101 = SealedDensity(c + int3(1, 0, 1));
            float d011 = SealedDensity(c + int3(0, 1, 1));
            float d111 = SealedDensity(c + int3(1, 1, 1));

            return float3(
                (d100 + d110 + d101 + d111) - (d000 + d010 + d001 + d011),
                (d010 + d110 + d011 + d111) - (d000 + d100 + d001 + d101),
                (d001 + d101 + d011 + d111) - (d000 + d100 + d010 + d110));
        }

        /// Where a ray meets a triangle: the distance in w, zero in w when it does not.
        /// Two sided on purpose - a facet is looked at from whichever side the camera happens to be.
        float4 MeetTriangle(float3 a, float3 b, float3 c, float3 origin, float3 direction)
        {
            float3 ab = b - a;
            float3 ac = c - a;
            float3 normal = cross(ab, ac);

            float denominator = dot(normal, direction);
            float hitT = abs(denominator) > 1e-12 ? dot(normal, a - origin) / denominator : -1;

            // Barycentric test at the intersection, in the plane's own frame.
            float3 planePoint = origin + direction * hitT - a;
            float d00 = dot(ab, ab);
            float d01 = dot(ab, ac);
            float d11 = dot(ac, ac);
            float d20 = dot(planePoint, ab);
            float d21 = dot(planePoint, ac);
            float area = d00 * d11 - d01 * d01;

            float v = abs(area) > 1e-12 ? (d11 * d20 - d01 * d21) / area : -1;
            float w = abs(area) > 1e-12 ? (d00 * d21 - d01 * d20) / area : -1;

            bool inside = hitT > 0 && v >= 0 && w >= 0 && v + w <= 1;
            return inside ? float4(normalize(normal), hitT) : float4(0, 1, 0, 0);
        }

        /// The nearer of two hits, either of which may be nothing.
        float4 Nearer(float4 first, float4 second)
        {
            bool takeSecond = second.w > 0 && (first.w <= 0 || second.w < first.w);
            return takeSecond ? second : first;
        }

        /// Where a ray meets the quad four cell vertices span, as two triangles.
        float4 MeetQuad(float4 v0, float4 v1, float4 v2, float4 v3, float3 origin, float3 direction)
        {
            if (v0.w <= 0 || v1.w <= 0 || v2.w <= 0 || v3.w <= 0)
                return float4(0, 1, 0, 0);

            float4 first = MeetTriangle(v0.xyz, v1.xyz, v2.xyz, origin, direction);
            float4 second = MeetTriangle(v0.xyz, v2.xyz, v3.xyz, origin, direction);
            return Nearer(first, second);
        }

        override bool Trace(float3 origin, float3 direction, float maxDistance, out float hitDistance, out float3 hitNormal, out float3 hitAlbedo)
        {
            hitDistance = 0;
            hitNormal = float3(0, 1, 0);
            hitAlbedo = float3(1, 1, 1);

            int3 cells = SampleCount() - int3(1, 1, 1);
            float cellSize = VoxelGridCellSize;
            float3 boundsMax = (float3)cells * cellSize;

            // A zero component would make the slab test compute 0 * infinity, which is a NaN rather
            // than the "never crosses this plane" the maths wants. Nudging it off zero keeps the
            // vectorized form, worth more than the exactness lost in the twelfth digit.
            float3 safeDirection = direction + (abs(direction) < 1e-8) * 1e-8;
            float3 inverseDirection = 1.0 / safeDirection;

            float3 toMin = (0.0 - origin) * inverseDirection;
            float3 toMax = (boundsMax - origin) * inverseDirection;
            float3 nearest = min(toMin, toMax);
            float3 farthest = max(toMin, toMax);
            float tEnter = max(max(nearest.x, nearest.y), max(nearest.z, 0.0));
            float tExit = min(min(farthest.x, farthest.y), min(farthest.z, maxDistance));

            bool cubes = VoxelGridSurfaceMode < 0.5;
            bool marching = VoxelGridSurfaceMode >= 0.5 && VoxelGridSurfaceMode < 1.5;
            bool nets = VoxelGridSurfaceMode >= 1.5;
            bool smooth = !cubes;
            bool running = tEnter <= tExit;
            bool hit = false;
            float tHit = 0;

            // Which face of the box the ray entered through. It is the normal to use when the first
            // cell is already solid - without it that case falls back on a fixed axis, and the
            // result is a wrongly lit band that slides about as the camera moves.
            int axis = nearest.x >= nearest.y && nearest.x >= nearest.z ? 0 : (nearest.y >= nearest.z ? 1 : 2);

            // Starting already inside matter - the volume cut by its own boundary - makes the box
            // face the surface, and there is nothing to refine.
            //
            // Only when the ray starts inside the box. Applied to a ray that comes from outside it
            // turns the whole boundary into surface, and the grid is then wrapped in a solid shell
            // the colour of whatever lights it - correct from within the volume, a grey cube from
            // without.
            bool startsInside = tEnter <= 0;
            if (running && startsInside && smooth && SampleField(origin + safeDirection * (tEnter + 1e-4)) >= VoxelGridIsoLevel)
            {
                hit = true;
                running = false;
                tHit = tEnter;
            }

            float3 entry = origin + safeDirection * tEnter;
            int3 cell = clamp((int3)floor(entry / cellSize), int3(0, 0, 0), max(cells - int3(1, 1, 1), int3(0, 0, 0)));
            int3 stepDirection = (int3)sign(safeDirection);
            float3 tDelta = abs(cellSize * inverseDirection);
            // The boundary ahead is the far face when stepping forwards, the near face otherwise.
            float3 boundary = ((float3)cell + max(sign(safeDirection), 0.0)) * cellSize;
            float3 tMax = (boundary - origin) * inverseDirection;

            float t = tEnter;

            // The facet a surface-nets hit landed on, kept because its own orientation is what makes
            // that surface look like surface nets; taking the field gradient at the point instead
            // smooths it straight back into the marching-cubes surface.
            int3 netsCell = int3(0, 0, 0);

            // Neither break nor return: an early return inside a loop miscompiles on some targets,
            // so the walk ends by clearing its condition instead.
            // Clamped, not trusted.
            //
            // An unbound constant buffer member does not read as zero, it reads as whatever was left
            // in that memory. A step count of two billion is a loop that never ends, and a pixel
            // shader that never ends takes the graphics device past its timeout and hangs it - so a
            // parameter that failed to bind stops being a blank screen and becomes a driver reset.
            // Nothing about a ray crossing this grid needs more steps than its diagonal in cells.
            int steps = clamp(VoxelGridMaxSteps, 0, 4096);
            for (int i = 0; i < steps && running; i++)
            {
                float tLeave = min(min(tMax.x, tMax.y), tMax.z);
                float tSegmentEnd = min(tLeave, tExit);

                // Flat rather than nested: an else attached to an if whose body is itself an if
                // parses as belonging to the inner one, and the shader is then rejected.
                bool solidCube = !smooth && CellIsSolid(cell);

                // Four points across the segment this cell gives the ray. Testing only where it
                // leaves misses a surface that enters and leaves within one cell, which is what
                // happens wherever one surface passes in front of another at a shallow angle - the
                // ray then carries on to a cell further back, one step lower, and that is the
                // staircase along such an edge.
                //
                // Written flat rather than as a loop on purpose: the bisection below is already a
                // loop, and three levels of nesting inside a shader method is more than the parser
                // will take.
                float t1 = lerp(t, tSegmentEnd, 0.25);
                float t2 = lerp(t, tSegmentEnd, 0.50);
                float t3 = lerp(t, tSegmentEnd, 0.75);

                bool in1 = smooth && SampleField(origin + safeDirection * t1) >= VoxelGridIsoLevel;
                bool in2 = smooth && SampleField(origin + safeDirection * t2) >= VoxelGridIsoLevel;
                bool in3 = smooth && SampleField(origin + safeDirection * t3) >= VoxelGridIsoLevel;
                bool in4 = smooth && SampleField(origin + safeDirection * tSegmentEnd) >= VoxelGridIsoLevel;

                bool crosses = smooth && CellStraddles(cell) && (in1 || in2 || in3 || in4);

                // The first point known to be inside, and the last one known to be outside: the
                // crossing is between them.
                float insideAt = in1 ? t1 : (in2 ? t2 : (in3 ? t3 : tSegmentEnd));
                float outsideAt = in1 ? t : (in2 ? t1 : (in3 ? t2 : t3));

                if (solidCube)
                {
                    // Cubes: the hit is the face the ray crossed to get here, which is where it
                    // already stands.
                    tHit = t;
                    hit = true;
                    running = false;
                }
                else if (crosses)
                {
                    // Bisect between where the ray was still outside and the first point known to be
                    // inside. Only a sign is ever needed, never a distance - which is what lets this
                    // work on a field that is not a distance field.
                    float low = outsideAt;
                    float high = insideAt;
                    for (int step = 0; step < RefineSteps; step++)
                    {
                        float mid = (low + high) * 0.5;
                        if (SampleField(origin + safeDirection * mid) >= VoxelGridIsoLevel)
                            high = mid;
                        else
                            low = mid;
                    }
                    tHit = high;
                    hit = true;
                    running = false;
                    netsCell = cell;
                }
                else
                {
                    if (tMax.x < tMax.y && tMax.x < tMax.z)
                    {
                        cell.x += stepDirection.x;
                        t = tMax.x;
                        tMax.x += tDelta.x;
                        axis = 0;
                    }
                    else if (tMax.y < tMax.z)
                    {
                        cell.y += stepDirection.y;
                        t = tMax.y;
                        tMax.y += tDelta.y;
                        axis = 1;
                    }
                    else
                    {
                        cell.z += stepDirection.z;
                        t = tMax.z;
                        tMax.z += tDelta.z;
                        axis = 2;
                    }

                    if (any(cell < int3(0, 0, 0)) || any(cell >= cells) || t > tExit)
                        running = false;
                }
            }

            if (hit)
            {
                float3 position = origin + safeDirection * tHit;
                hitDistance = tHit;
                // Cubes take the cell's own colour, which is the point of cubes; a smooth surface
                // takes the blend, so the material boundary is as smooth as the surface carrying it.
                hitAlbedo = smooth
                    ? SampleAlbedo(position)
                    : Albedo(clamp((int3)floor(position / cellSize), int3(0, 0, 0), max(cells - int3(1, 1, 1), int3(0, 0, 0))));

                float3 faceNormal = float3(
                    axis == 0 ? -stepDirection.x : 0,
                    axis == 1 ? -stepDirection.y : 0,
                    axis == 2 ? -stepDirection.z : 0);

                if (nets)
                {
                    // Every quad surface nets stitches that can cover a point in this cell, not
                    // just the three the cell owns. A quad is spanned by the vertices of the four
                    // cells around a grid edge, so the one covering a pixel usually belongs to a
                    // neighbour: testing only the owned three left most pixels on the fallback
                    // below, which is a different surface, and the two interleaved as shingles.
                    // The same reach the collider needed, for the same reason.
                    //
                    // Nineteen cell vertices - every offset with at least one zero component - and
                    // twelve quads. At twelve edge crossings and two density reads each that is 456
                    // reads, all inlined through the source composition, and it compiles without
                    // trouble. What made the compiler run away before was doing this work at every
                    // step of the walk; once per pixel, the count alone is not the problem.
                    int3 c = netsCell;

                    float4 vP00 = CellVertex(c + int3( 1,  0,  0));
                    float4 vM00 = CellVertex(c + int3(-1,  0,  0));
                    float4 v0P0 = CellVertex(c + int3( 0,  1,  0));
                    float4 v0M0 = CellVertex(c + int3( 0, -1,  0));
                    float4 v00P = CellVertex(c + int3( 0,  0,  1));
                    float4 v00M = CellVertex(c + int3( 0,  0, -1));
                    float4 v000 = CellVertex(c);

                    float4 v0PP = CellVertex(c + int3( 0,  1,  1));
                    float4 v0PM = CellVertex(c + int3( 0,  1, -1));
                    float4 v0MP = CellVertex(c + int3( 0, -1,  1));
                    float4 v0MM = CellVertex(c + int3( 0, -1, -1));

                    float4 vP0P = CellVertex(c + int3( 1,  0,  1));
                    float4 vP0M = CellVertex(c + int3( 1,  0, -1));
                    float4 vM0P = CellVertex(c + int3(-1,  0,  1));
                    float4 vM0M = CellVertex(c + int3(-1,  0, -1));

                    float4 vPP0 = CellVertex(c + int3( 1,  1,  0));
                    float4 vPM0 = CellVertex(c + int3( 1, -1,  0));
                    float4 vMP0 = CellVertex(c + int3(-1,  1,  0));
                    float4 vMM0 = CellVertex(c + int3(-1, -1,  0));

                    // The four quads on the x edges, wound round the edge.
                    float4 best = MeetQuad(v000, v0M0, v0MM, v00M, origin, safeDirection);
                    best = Nearer(best, MeetQuad(v00P, v0MP, v0M0, v000, origin, safeDirection));
                    best = Nearer(best, MeetQuad(v0P0, v000, v00M, v0PM, origin, safeDirection));
                    best = Nearer(best, MeetQuad(v0PP, v00P, v000, v0P0, origin, safeDirection));

                    // The four on the y edges.
                    best = Nearer(best, MeetQuad(v000, vM00, vM0M, v00M, origin, safeDirection));
                    best = Nearer(best, MeetQuad(v00P, vM0P, vM00, v000, origin, safeDirection));
                    best = Nearer(best, MeetQuad(vP00, v000, v00M, vP0M, origin, safeDirection));
                    best = Nearer(best, MeetQuad(vP0P, v00P, v000, vP00, origin, safeDirection));

                    // The four on the z edges.
                    best = Nearer(best, MeetQuad(v000, vM00, vMM0, v0M0, origin, safeDirection));
                    best = Nearer(best, MeetQuad(v0P0, vMP0, vM00, v000, origin, safeDirection));
                    best = Nearer(best, MeetQuad(vP00, v000, v0M0, vPM0, origin, safeDirection));
                    best = Nearer(best, MeetQuad(vPP0, v0P0, v000, vP00, origin, safeDirection));

                    if (best.w > 0)
                    {
                        hitDistance = best.w;
                        position = origin + safeDirection * best.w;
                        // Facing the camera, because a quad is stitched without a preferred side.
                        hitNormal = dot(best.xyz, safeDirection) > 0 ? -best.xyz : best.xyz;
                    }
                    else
                    {
                        hitNormal = normalize(-CellNormal(netsCell));
                    }
                }
                else if (smooth)
                {
                    float3 gradient = FieldGradient(position);
                    // Density rises into matter, so the outward normal is the gradient reversed. A
                    // region flat enough to have no gradient has no orientation either; the face
                    // just crossed is then the only answer available.
                    hitNormal = dot(gradient, gradient) > 1e-12 ? normalize(-gradient) : faceNormal;
                }
                else
                {
                    hitNormal = faceNormal;
                }
            }

            return hit;
        }
    };
}
