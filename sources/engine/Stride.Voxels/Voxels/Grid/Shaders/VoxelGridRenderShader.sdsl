namespace Stride.Rendering.Voxels.Grid
{
    /// Draws a voxel grid by tracing one ray per pixel and writing depth.
    ///
    /// Writing depth is what makes this a pass rather than an overlay: the grid takes its place in
    /// the depth buffer, and everything else in the scene - props, characters, machines - rasterizes
    /// against it as it would against any other geometry. Nothing downstream needs to know the
    /// terrain was never triangles.
    shader VoxelGridRenderShader : ImageEffectShader
    {
        compose IVoxelGridTraversal Traversal;

        /// Clip space to world space, for turning a pixel into a ray.
        float4x4 VoxelGridViewProjectionInverse;
        /// World space to clip space, for putting the hit back into the depth buffer.
        float4x4 VoxelGridViewProjection;
        /// World space to grid local space, where the traversal works.
        float4x4 VoxelGridWorldInverse;
        /// Grid local space back to world space.
        float4x4 VoxelGridWorld;

        float3 VoxelGridEyePosition;
        float VoxelGridMaxDistance;

        /// 0 draws the grid; 1 the ray direction; 2 the ray origin in grid space; 3 the box the
        /// grid occupies. A pass that produces nothing looks the same whether the rays are wrong,
        /// the composition is empty or the target is not the one on screen, and these tell them
        /// apart in one run each.
        float VoxelGridDebugMode;

        /// Extent of the grid in its own space, for the box view above.
        float3 VoxelGridDebugBounds;

        float3 VoxelGridLightDirection;
        float3 VoxelGridLightColor;
        float3 VoxelGridAmbientColor;

        stage override float4 Shading()
        {
            float2 uv = streams.TexCoord;
            // Clip space has y up and the viewport y down, and the far plane is z = 1 in Stride.
            float4 clipPosition = float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 1.0);
            float4 farPoint = mul(clipPosition, VoxelGridViewProjectionInverse);
            float3 worldDirection = normalize(farPoint.xyz / farPoint.w - VoxelGridEyePosition);

            float3 localOrigin = mul(float4(VoxelGridEyePosition, 1), VoxelGridWorldInverse).xyz;
            float3 localDirection = mul(float4(worldDirection, 0), VoxelGridWorldInverse).xyz;
            // The traversal reports distances along a unit direction, so any scale baked into the
            // grid transform has to come out here and go back in below.
            float directionScale = length(localDirection);
            localDirection = localDirection / directionScale;

            if (VoxelGridDebugMode > 0.5)
            {
                if (VoxelGridDebugMode < 1.5)
                    return float4(worldDirection * 0.5 + 0.5, 1);
                if (VoxelGridDebugMode < 2.5)
                    return float4(frac(localOrigin * 0.0625), 1);

                // Mode 3: does the ray meet the grid box at all - the question that separates "the
                // traversal found nothing" from "the grid is not in front of the camera".
                float3 boundsMax = VoxelGridDebugBounds;
                float3 inverseDirection = 1.0 / (localDirection + (abs(localDirection) < 1e-8) * 1e-8);
                float3 toMin = (0.0 - localOrigin) * inverseDirection;
                float3 toMax = (boundsMax - localOrigin) * inverseDirection;
                float3 nearest = min(toMin, toMax);
                float3 farthest = max(toMin, toMax);
                float tEnter = max(max(nearest.x, nearest.y), max(nearest.z, 0.0));
                float tExit = min(min(farthest.x, farthest.y), farthest.z);
                if (VoxelGridDebugMode < 3.5)
                    return tEnter <= tExit ? float4(0.1, 0.9, 0.2, 1) : float4(0.15, 0.15, 0.18, 1);

                // Mode 4: what the source reports at the middle of the grid. Red is the sample count
                // over 128, green the density there, blue the iso level.
                return float4(Traversal.Probe(VoxelGridDebugBounds * 0.5), 1);
            }

            float hitDistance;
            float3 localNormal;
            float3 albedo;
            if (!Traversal.Trace(localOrigin, localDirection, VoxelGridMaxDistance * directionScale, hitDistance, localNormal, albedo))
            {
                // Leaving both colour and depth untouched is what lets this pass run before or after
                // anything else without having to know which.
                discard;
            }

            float3 localPosition = localOrigin + localDirection * hitDistance;
            float3 worldPosition = mul(float4(localPosition, 1), VoxelGridWorld).xyz;
            float3 worldNormal = normalize(mul(float4(localNormal, 0), VoxelGridWorld).xyz);

            float4 hitClip = mul(float4(worldPosition, 1), VoxelGridViewProjection);
            streams.Depth = hitClip.z / hitClip.w;

            // Deliberately the least lighting that still shows shape. Global illumination is the
            // clipmap's job, and this pass exists to put voxels on screen and in the depth buffer.
            float lambert = saturate(dot(worldNormal, -VoxelGridLightDirection));
            float3 color = albedo * (VoxelGridAmbientColor + VoxelGridLightColor * lambert);
            return float4(color, 1.0);
        }
    };
}
