namespace Stride.Rendering.Voxels.Grid
{
    /// The colour the voxel field carries, as a material compute node.
    ///
    /// Plugged into a material's diffuse slot, this is how a voxel body gets its own palette while
    /// staying an ordinary material: the surface feature resolves the field and leaves the colour on
    /// a stream, and the diffuse feature asks for it here like it would ask a texture. A user who
    /// wants something else puts something else in that slot, and the field's colours are simply not
    /// consulted - which is the same choice they have on any other model.
    shader ComputeColorVoxelAlbedo : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            // matColorBase, one of the material's own streams, rather than a stream of ours. A
            // material is generated for the vertex stage as well as the pixel stage and this node
            // runs in both; a stream of our own is unwritten in the vertex stage, and the compiler
            // then takes it for a vertex buffer input with no semantic and refuses to build the
            // effect - after which the mesh render feature draws nothing at all, every other model
            // in the scene included. The material's streams are already reset for every stage.
            return float4(streams.matColorBase.rgb, 1);
        }
    };
}
