namespace Stride.Rendering.Voxels.Grid
{
    /// The field's diffuse colour, as a material compute node: the surface feature left it on the
    /// material's own stream, already darkened by metalness, and this hands it back so the diffuse
    /// feature - whose presence is what makes the generator add lighting at all - keeps it.
    ///
    /// The material's stream rather than one of ours: a compute node runs in the vertex stage as
    /// well, where a stream of ours is unwritten and taken for a vertex input the mesh has not got.
    shader ComputeColorVoxelDiffuse : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            return streams.matDiffuse;
        }
    };
}
