namespace Stride.Rendering.Voxels.Grid
{
    /// The field's specular colour, as a material compute node. See ComputeColorVoxelDiffuse.
    shader ComputeColorVoxelSpecular : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            return float4(streams.matSpecular, 1);
        }
    };
}
