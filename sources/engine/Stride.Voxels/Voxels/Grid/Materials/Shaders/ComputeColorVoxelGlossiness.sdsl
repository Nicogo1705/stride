namespace Stride.Rendering.Voxels.Grid
{
    /// The field's glossiness, as a material compute node. See ComputeColorVoxelDiffuse.
    shader ComputeColorVoxelGlossiness : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            return float4(streams.matGlossiness, 0, 0, 0);
        }
    };
}
