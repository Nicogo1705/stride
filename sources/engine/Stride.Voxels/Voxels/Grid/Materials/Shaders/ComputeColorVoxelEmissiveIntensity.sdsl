namespace Stride.Rendering.Voxels.Grid
{
    /// The strength of what the field emits, as a material compute node. See ComputeColorVoxelEmissive.
    shader ComputeColorVoxelEmissiveIntensity : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            return float4(streams.matEmissiveIntensity, 0, 0, 0);
        }
    };
}
