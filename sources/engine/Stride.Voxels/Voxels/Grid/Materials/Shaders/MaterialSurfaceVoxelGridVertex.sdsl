namespace Stride.Rendering.Voxels.Grid
{
    /// The vertex half of the voxel surface: nothing to displace, only the pass stream to define,
    /// so that the pixel half may ask which pass it is in whatever the pass.
    shader MaterialSurfaceVoxelGridVertex : IMaterialSurfaceVertex, ShadowMapCasterPassInfo
    {
        override void Compute()
        {
            streams.IsShadowMapCasterPass = 0;
        }
    };
}
