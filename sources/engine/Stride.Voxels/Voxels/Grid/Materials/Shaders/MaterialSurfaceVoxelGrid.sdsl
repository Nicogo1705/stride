namespace Stride.Rendering.Voxels.Grid
{
    /// The grid's shadow: a material that walks the field only in the shadow caster passes.
    ///
    /// The resolve pass finds the surface for the camera; the shadow maps are other views, one per
    /// cascade or face, and each walks the field on its own from the light. This runs on a proxy
    /// box of the grid that casts shadows and draws nothing else: in every pass but a caster it
    /// discards, and in a caster it asks the traversal only where the ray meets the field.
    shader MaterialSurfaceVoxelGrid : IMaterialSurfacePixel, Transformation, PositionStream4, ShaderBaseStream, MaterialPixelStream, IVoxelGridTraversal, ShadowMapCasterPassInfo, VoxelizationPassInfo
    {
        // The traversal and its source are inherited, not composed, so all three share one scope
        // and the field's resource is declared once. See VoxelGridTraversalDDA.

        cbuffer PerMaterial
        {
            /// How far along the ray the surface is looked for, in grid local units. The processor
            /// sets it to the grid's diagonal when nothing else was asked for.
            [Link("VoxelGridField.MaxDistance")]
            stage float VoxelGridMaxDistance;
        }

        override void Compute()
        {
            // One exit, no early return: a return from inside a material's Compute comes out of
            // the SPIR-V to HLSL step as a one-iteration loop round everything after it, and FXC,
            // asked to unroll that round the walk's own loop, gives up with an internal error.
            // A caster pass, and not the voxelizer's - the two flags are set by different passes
            // and only the caster one may be stale where a geometry shader dropped it.
            if (streams.IsShadowMapCasterPass > 0.5 && streams.IsVoxelizationPass < 0.5)
            {
                // The fragment, in the grid's own space. Shadow maps are orthographic for a
                // directional light and perspective for the others; the ray reaches the fragment
                // from the eye under a perspective projection, and along the view axis under an
                // orthographic one, which is the case when w does not depend on z.
                float3 targetLocal = mul(float4(streams.PositionWS.xyz, 1), WorldInverse).xyz;
                float reach = VoxelGridMaxDistance > 0 ? VoxelGridMaxDistance : 64.0;
                float3 originLocal;
                float3 directionLocal;

                bool orthographic = abs(Projection._34) < 1e-6 && abs(Projection._44 - 1.0) < 1e-6;
                if (orthographic)
                {
                    float3 forwardWS = normalize(mul(float4(0, 0, -1, 0), ViewInverse).xyz);
                    directionLocal = normalize(mul(float4(forwardWS, 0), WorldInverse).xyz);
                    // Started far enough back to be outside the volume; the traversal clips to it.
                    originLocal = targetLocal - directionLocal * reach;
                }
                else
                {
                    originLocal = mul(float4(Eye.xyz, 1), WorldInverse).xyz;
                    float3 towards = targetLocal - originLocal;
                    float travel = length(towards);
                    directionLocal = travel > 1e-6 ? towards / travel : float3(0, 0, 1);
                }

                // A shadow map reads the depth and nothing else, so the ray is asked only where it
                // meets the field, and settles a fraction of a cell past it - on the far side, so
                // the surface never shadows itself.
                float occluderDistance;
                bool blocked = Occlude(originLocal, directionLocal, orthographic ? 2.0 * reach : reach, occluderDistance);
                if (!blocked)
                    discard;

                float4 occluderClip = mul(mul(float4(originLocal + directionLocal * occluderDistance, 1), World), ViewProjection);
                streams.Depth = occluderClip.z / occluderClip.w;

                // Opaque, in so many words: the caster keeps a fragment on the material's alpha,
                // and the streams were reset to zero before this ran.
                streams.matColorBase = float4(0, 0, 0, 1);
                streams.matDiffuse = float4(0, 0, 0, 1);
            }
            else
            {
                // The camera's passes draw the grid through its materials, not through this; and
                // the voxelizer is told so, since a discard alone leaves its store to run.
                streams.VoxelizationSkip = 1;
                discard;
            }
        }
    };
}
