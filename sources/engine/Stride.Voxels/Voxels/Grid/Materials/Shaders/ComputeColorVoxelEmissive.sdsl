namespace Stride.Rendering.Voxels.Grid
{
    /// What the field emits, as a material compute node: the surface feature left it on the
    /// material's own emissive stream, and this hands it back so the emissive feature adds it.
    ///
    /// The material's stream rather than one of ours: a compute node runs in the vertex stage as
    /// well, where a stream of ours is unwritten and taken for a vertex input the mesh has not got.
    shader ComputeColorVoxelEmissive : ComputeColor, MaterialPixelStream
    {
        override float4 Compute()
        {
            return streams.matEmissive;
        }
    };
}
